#!/usr/bin/env bash
set -euo pipefail

status_start() {
    printf '\n\033[1;34m==>\033[0m %s\n' "$1"
}

status_done() {
    printf '\033[1;32m✓ %s\033[0m\n' "$1"
}

export DEBIAN_FRONTEND=noninteractive

status_start 'Updating package index'
apt-get update -qq
status_done 'Package index is ready'

status_start 'Upgrading system packages'
apt-get dist-upgrade -y -qq
status_done 'System packages are upgraded'

status_start 'Installing system packages'
apt-get install -y -qq --no-install-recommends \
    bubblewrap \
    build-essential \
    bzip2 \
    ca-certificates \
    clang \
    curl \
    elan \
    file \
    fonts-liberation \
    fzf \
    gawk \
    gh \
    git \
    git-delta \
    gnupg \
    gir1.2-nm-1.0 \
    gir1.2-secret-1 \
    gir1.2-gtk-3.0 \
    gir1.2-notify-0.7 \
    htop \
    hyperfine \
    jq \
    just \
    less \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libatspi2.0-0t64 \
    libgbm1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    make \
    man-db \
    nano \
    nauty \
    neovim \
    network-manager \
    network-manager-openvpn \
    nodejs \
    npm \
    openjdk-25-jdk-headless \
    openjdk-25-jre-headless \
    openssh-client \
    pandoc \
    patch \
    pkg-config \
    poppler-utils \
    procps \
    pypy3 \
    python3 \
    python3-gi \
    python3-venv \
    python3-mypy \
    python3-pygments \
    ripgrep \
    shellcheck \
    shfmt \
    starship \
    time \
    tmux \
    tzdata \
    unzip \
    which \
    xz-utils \
    zip \
    zstd
status_done 'System packages are ready'

status_start 'Setting up eduVPN networking'
groupadd -f eduvpn
install -d -m 755 /etc/polkit-1/rules.d
cat >/etc/polkit-1/rules.d/49-eduvpn.rules <<'EOF'
// Allow CLI sessions in the VM to manage VPN connections without a GUI agent.
polkit.addRule(function(action, subject) {
    if (subject.isInGroup("eduvpn") &&
        ["org.freedesktop.NetworkManager.network-control",
         "org.freedesktop.NetworkManager.settings.modify.own",
         "org.freedesktop.NetworkManager.settings.modify.system"].indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }
});
EOF
systemctl enable --now NetworkManager

# Preserve cloud-init's DHCP/DNS settings, changing only the primary renderer.
network_config=/etc/netplan/90-agent-networkmanager.yaml
networkd_config=/etc/systemd/network/09-agent-networkmanager.network
networkd_candidate=$(mktemp)
cat >"${networkd_candidate}" <<'EOF'
[Match]
Name=eth0

[Link]
Unmanaged=yes
EOF
network_candidate=$(mktemp)
cat >"${network_candidate}" <<'EOF'
network:
  version: 2
  ethernets:
    eth0:
      renderer: NetworkManager
EOF
if ! cmp -s "${network_candidate}" "${network_config}" ||
    ! cmp -s "${networkd_candidate}" "${networkd_config}"; then
    install -d -m 700 /var/lib/agent-network-backup
    backup_timestamp=$(date +%s)
    cp -a /etc/netplan "/var/lib/agent-network-backup/netplan-${backup_timestamp}"
    rollback=/var/lib/agent-network-backup/rollback.sh
    if [[ -f ${network_config} ]]; then
        cp -a "${network_config}" /var/lib/agent-network-backup/previous.yaml
        printf '%s\n' '#!/bin/sh' \
            'cp /var/lib/agent-network-backup/previous.yaml /etc/netplan/90-agent-networkmanager.yaml' >"${rollback}"
    else
        printf '%s\n' '#!/bin/sh' \
            'rm -f /etc/netplan/90-agent-networkmanager.yaml' >"${rollback}"
    fi
    if [[ -f ${networkd_config} ]]; then
        cp -a "${networkd_config}" /var/lib/agent-network-backup/previous.network
        printf '%s\n' 'cp /var/lib/agent-network-backup/previous.network /etc/systemd/network/09-agent-networkmanager.network' >>"${rollback}"
    else
        printf '%s\n' 'rm -f /etc/systemd/network/09-agent-networkmanager.network' >>"${rollback}"
    fi
    printf '%s\n' 'netplan apply' 'networkctl reload' >>"${rollback}"
    chmod 700 "${rollback}"
    systemd-run --unit=agent-network-rollback --on-active=120s /bin/sh "${rollback}"
    install -m 600 "${network_candidate}" "${network_config}"
    # Prevent dracut's catch-all networkd profile from also starting DHCP.
    install -D -m 644 "${networkd_candidate}" "${networkd_config}"
    netplan generate
    netplan apply
    networkctl reload
    # Leave the rollback armed if either routing or DNS/HTTPS is broken.
    nm-online --quiet --timeout=30
    curl --fail --silent --show-error --retry 3 --max-time 15 \
        https://pypi.org/simple/eduvpn-client/ >/dev/null
    systemctl stop agent-network-rollback.timer
fi
# eth0 is now managed by NetworkManager. Waiting for networkd would delay
# network-online.target and SSH logins until its 120-second timeout expires.
# Run this even when the renderer configuration was already installed.
systemctl enable --now NetworkManager-wait-online.service
systemctl disable --now systemd-networkd-wait-online.service
rm -f "${network_candidate}" "${networkd_candidate}"
status_done 'eduVPN networking is ready'

status_start 'Setting up swapfile'
swapfile=/swapfile
if [[ ! -f ${swapfile} ]]; then
    if ! fallocate -l 8G "${swapfile}" 2>/dev/null; then
        dd if=/dev/zero of="${swapfile}" bs=1M count=8192 status=none
    fi
    chmod 600 "${swapfile}"
    if ! mkswap "${swapfile}"; then
        rm -f "${swapfile}"
        dd if=/dev/zero of="${swapfile}" bs=1M count=8192 status=none
        chmod 600 "${swapfile}"
        mkswap "${swapfile}"
    fi
fi
chmod 600 "${swapfile}"
grep -Fqx '/swapfile none swap sw 0 0' /etc/fstab || printf '%s\n' '/swapfile none swap sw 0 0' >>/etc/fstab
if ! swapon --show=NAME --noheadings | grep -Fqx "${swapfile}"; then
    swapon "${swapfile}"
fi
status_done 'Swap is ready'
