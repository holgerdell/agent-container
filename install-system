#!/usr/bin/env bash
set -euo pipefail

status_start() {
    printf '\n\033[1;34m==>\033[0m %s\n' "$1"
}

status_done() {
    printf '\033[1;32m✓ %s\033[0m\n' "$1"
}

provision_marker=/var/lib/lima/package-provision-complete
if [[ -e "${provision_marker}" ]]; then
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive

status_start 'Updating package index'
apt-get update -qq
status_done 'Package index is ready'

status_start 'Upgrading system packages'
apt-get dist-upgrade -y -qq
status_done 'System packages are upgraded'

status_start 'Installing system packages'
apt-get install -y -qq --no-install-recommends \
    bubblewrap \
    build-essential \
    bzip2 \
    ca-certificates \
    clang \
    curl \
    elan \
    file \
    fonts-liberation \
    fzf \
    gawk \
    gh \
    git \
    git-delta \
    gnupg \
    htop \
    hyperfine \
    jq \
    just \
    less \
    libasound2t64 \
    libatk-bridge2.0-0t64 \
    libatk1.0-0t64 \
    libatspi2.0-0t64 \
    libgbm1 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    make \
    man-db \
    nano \
    nauty \
    neovim \
    nodejs \
    npm \
    openjdk-25-jdk-headless \
    openjdk-25-jre-headless \
    openssh-client \
    pandoc \
    patch \
    pkg-config \
    poppler-utils \
    procps \
    pypy3 \
    python3 \
    python3-mypy \
    python3-pygments \
    ripgrep \
    shellcheck \
    shfmt \
    starship \
    time \
    tmux \
    tzdata \
    unzip \
    which \
    xz-utils \
    zip \
    zstd
status_done 'System packages are ready'

install -D /dev/null "${provision_marker}"
