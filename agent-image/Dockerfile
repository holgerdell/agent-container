# The agent runtime image: a disposable Debian Sid system plus the APT packages
# selected in settings. Everything persistent (native tools, tool state, caches,
# credentials) lives in the shared /home/agent volume, never here.
#
# The build context is generated by `agent build`: this file, `apt-packages.txt`
# (one package name per line, from settings), and `image-metadata.json` (the APT
# selection fingerprint). `--pull` is always used, so a republished base image
# invalidates every layer below and the packages are reinstalled from the current
# Debian archive; `agent build --refresh` forces that regardless.
FROM debian:sid-slim

ARG AGENT_UID=1000
ARG AGENT_GID=1000
ARG AGENT_APT_FINGERPRINT=unknown
# Native-installer bin directories, generated from one list in `agent` alongside
# /etc/profile.d/agent.sh, so adding an extra's bin dir is a single-place edit.
ARG AGENT_PATH

# Read at session launch to detect drift between the image and current settings.
LABEL agent.apt.fingerprint="${AGENT_APT_FINGERPRINT}"

ENV DEBIAN_FRONTEND=noninteractive

# APT is the authority on package availability: an invalid, renamed, or
# unavailable name fails here, which is the intended failure mode.
COPY apt-packages.txt /tmp/apt-packages.txt
RUN set -eux; \
    apt-get update; \
    xargs -a /tmp/apt-packages.txt apt-get install -y --no-install-recommends; \
    rm -rf /var/lib/apt/lists/* /tmp/apt-packages.txt

# UTF-8 throughout, with no dependency on the configured package set: C.UTF-8 is
# built into glibc, so it needs neither the `locales` package nor a generation
# step, and it survives the slim base's removal of /usr/share/locale. LC_ALL is
# deliberately left unset so a session can still override single categories.
ENV LANG=C.UTF-8

COPY root/ /
COPY image-metadata.json /etc/agent/image.json

# The agent account carries the *host* UID/GID so files created through the
# workspace bind mount keep correct ownership. The GID may already belong to a
# Debian system group (host GID 20 is `dialout` here), which is harmless — the
# account just joins it.
RUN set -eux; \
    groupadd -g "$AGENT_GID" agent 2>/dev/null || true; \
    useradd -u "$AGENT_UID" -g "$AGENT_GID" -d /home/agent -s /bin/bash -M agent; \
    mkdir -p /home/agent; \
    chown "$AGENT_UID:$AGENT_GID" /home/agent; \
    printf '%s\n' 'command -v starship >/dev/null && eval "$(starship init bash)"' >> /etc/bash.bashrc; \
    printf '%s\n' 'set enable-bracketed-paste on' >> /etc/inputrc

# Native upstream installers write into $HOME; their standard bin directories are
# on PATH here so tools work in `docker exec` and in coding-agent launches. The
# generated /etc/profile.d/agent.sh puts the same directories back for login
# shells (and so for `bash -lc` updater commands), which rebuild PATH from scratch.
#
# DISABLE_AUTOUPDATER silences Claude Code's updater and OPENCODE_DISABLE_AUTOUPDATE
# OpenCode's: those two are the ones that upgrade themselves unprompted, and since
# several containers share one home volume, a silent upgrade would rewrite a tool
# underneath the other sessions and desync it from the recorded managed-extras
# state. Codex and Mistral Vibe only ever offer an upgrade and wait to be told, so
# they are left alone — muting them would mean writing into the user's own config
# files, which `agent` otherwise never touches.
#
# UV_PREVIEW_FEATURES moves project virtualenvs out of the project tree and into
# the uv cache under $HOME, keyed by project path so nested projects in one repo
# still get their own. The workspace is a bind mount, and installing a virtualenv
# into it does not merely run slowly — it fails partway through with a missing
# source file. uv leaves a `.venv` symlink behind for editors, which the shipped
# gitignore covers. Two caveats: `uv cache clean`/`prune` drops every one of these
# environments rather than just orphaned ones, and an unrecognised preview name is
# only warned about, so a later rename would quietly put them back in the mount.
#
# UV_PROJECT_ENVIRONMENT must stay unset, since any explicit path opts back out of
# the above — and could not express it anyway: a relative value resolves inside the
# project tree, and one absolute value would be shared by every project. UV_LINK_MODE
# is unset for the reason it was once `copy`: that pinning only existed because uv
# cannot reflink or hardlink out of its cache across the bind-mount boundary.
ENV HOME=/home/agent \
    PATH=${AGENT_PATH}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    EDITOR=nvim \
    VISUAL=nvim \
    NPM_CONFIG_PREFIX=/home/agent/.local \
    UV_PREVIEW_FEATURES=centralized-project-envs \
    UV_PYTHON_PREFERENCE=only-system \
    DEVCONTAINER=true \
    XDG_CONFIG_HOME=/home/agent/.config \
    XDG_DATA_HOME=/home/agent/.local/share \
    XDG_STATE_HOME=/home/agent/.local/state \
    XDG_CACHE_HOME=/home/agent/.cache \
    DISABLE_AUTOUPDATER=1 \
    OPENCODE_DISABLE_AUTOUPDATE=1

USER agent
WORKDIR /home/agent
CMD ["bash"]
