#!/usr/bin/env bash
set -euo pipefail

status_start() {
    printf '\n\033[1;34m==>\033[0m %s\n' "$1"
}

status_done() {
    printf '\033[1;32m✓ %s\033[0m\n' "$1"
}

export PATH="${HOME}/.local/bin:${HOME}/.bun/bin:${HOME}/.opencode/bin:${PATH}"

profile_path="${HOME}/.profile"
path_export="export PATH=\"${HOME}/.local/bin:${HOME}/.bun/bin:${HOME}/.opencode/bin:\$PATH\""
grep -Fqx "${path_export}" "${profile_path}" 2>/dev/null ||
    printf '\n%s\n' "${path_export}" >>"${profile_path}"

extras_dir="${HOME}/.local/share/agent-extras"

version_of() {
    command -v "$1" >/dev/null 2>&1 || return 0
    "$1" --version 2>&1 |
        grep -oE '[0-9]+\.[0-9]+[0-9A-Za-z.+-]*' |
        head -1
}

github_latest() {
    curl -fsSLo /dev/null -w '%{url_effective}' \
        "https://github.com/$1/releases/latest" |
        sed 's|.*/||; s|.*%40||; s|.*@||; s|^v||'
}

install_release() {
    local name=$1
    local latest=$2
    local url=$3
    local binary=$4
    local strip=${5:-0}
    local current target work archive extract

    current=$(version_of "${name}")
    [[ ${current} == "${latest}" ]] && return

    target="${extras_dir}/${name}"
    mkdir -p "${extras_dir}"
    work=$(mktemp -d "${extras_dir}/.install-${name}.XXXXXX")
    archive="${work}/archive"
    extract="${work}/extract"
    mkdir "${extract}"

    if ! curl -fsSL "${url}" -o "${archive}"; then
        rm -rf "${work}"
        return 1
    fi

    if ((strip)); then
        if ! tar -xaf "${archive}" -C "${extract}" --strip-components="${strip}"; then
            rm -rf "${work}"
            return 1
        fi
    else
        if ! tar -xaf "${archive}" -C "${extract}"; then
            rm -rf "${work}"
            return 1
        fi
    fi

    mkdir -p "${HOME}/.local/bin"
    rm -rf "${target}"
    mv "${extract}" "${target}"
    ln -sfn "${target}/${binary}" "${HOME}/.local/bin/${name}"
    rm -rf "${work}"
}

# Run in a subshell so temporary downloads are removed on any failure.
update_vscode_server() (
    local root=$1 quality=$2 label=$3
    local entry installed=0 modern=0 arch work commit target server
    for entry in "${root}"/bin/*/bin/code-server; do
        [[ -x ${entry} ]] && installed=1
    done
    for entry in "${root}/cli/servers/${label}-"*/server/bin/code-server; do
        if [[ -x ${entry} ]]; then
            installed=1
            modern=1
        fi
    done
    ((installed)) || return 0

    status_start "Updating VS Code Server (${quality}) and extensions"
    arch=$(uname -m)
    case ${arch} in
    x86_64) arch=x64 ;;
    aarch64 | arm64) arch=arm64 ;;
    armv7l) arch=armhf ;;
    *)
        echo "Unsupported VS Code Server architecture: ${arch}" >&2
        return 1
        ;;
    esac
    work=$(mktemp -d "${root}/.agent-update.XXXXXX")
    trap 'rm -rf -- "${work}"' EXIT
    curl -fsSL "https://update.code.visualstudio.com/latest/server-linux-${arch}/${quality}" \
        -o "${work}/server.tar.gz"
    mkdir "${work}/server"
    tar -xzf "${work}/server.tar.gz" -C "${work}/server" --strip-components=1
    commit=$(jq -er '.commit' "${work}/server/product.json")
    if [[ ! ${commit} =~ ^[0-9a-f]{40}$ ]]; then
        echo "Invalid VS Code Server commit: ${commit}" >&2
        return 1
    fi
    "${work}/server/bin/code-server" --version

    if ((modern)); then
        target="${root}/cli/servers/${label}-${commit}"
        server="${target}/server"
    else
        target="${root}/bin/${commit}"
        server=${target}
    fi
    if [[ ! -x ${server}/bin/code-server ]]; then
        # Move only a complete, validated download into the installed layout.
        if ((modern)); then
            mkdir -p "${target}"
        else
            mkdir -p "${root}/bin"
        fi
        if [[ -e ${server} ]]; then
            echo "Incomplete VS Code Server installation at ${server}; remove it and retry" >&2
            return 1
        fi
        mv "${work}/server" "${server}"
    fi
    # Invoke the standalone server CLI, independent of any active remote session.
    VSCODE_AGENT_FOLDER="${root}" "${server}/bin/code-server" \
        --extensions-dir "${root}/extensions" --update-extensions

    # Restrict cleanup to versioned server directories; preserve settings,
    # extensions, and the Remote-SSH CLI launchers managed by the client.
    for entry in "${root}"/bin/*; do
        [[ -d ${entry} && ${entry} != "${target}" ]] || continue
        [[ ${entry##*/} =~ ^[0-9a-f]{40}$ ]] || continue
        rm -rf -- "${entry}"
    done
    for entry in "${root}/cli/servers/${label}-"*; do
        [[ -d ${entry} && ${entry} != "${target}" ]] || continue
        [[ ${entry##*/} =~ ^${label}-[0-9a-f]{40}$ ]] || continue
        rm -rf -- "${entry}"
    done
    status_done "VS Code Server (${quality}) and extensions are updated"
)

update_vscode_server "${HOME}/.vscode-server" stable Stable
update_vscode_server "${HOME}/.vscode-server-insiders" insider Insiders

status_start 'Setting up uv'
if command -v uv >/dev/null 2>&1; then
    uv self update
else
    curl -LsSf https://astral.sh/uv/install.sh |
        INSTALLER_NO_MODIFY_PATH=1 sh
fi
status_done 'uv is ready'

status_start 'Setting up Python tools'
for tool in ruff ty typos mistral-vibe; do
    uv tool install --upgrade "${tool}"
done
status_done 'Python tools are ready'

status_start 'Setting up eduVPN'
# Use Ubuntu's Python so the venv can import the apt-installed GI bindings.
eduvpn_env="${HOME}/.local/share/eduvpn-venv"
/usr/bin/python3 -m venv --system-site-packages "${eduvpn_env}"
"${eduvpn_env}/bin/python" -m pip install --upgrade eduvpn-client
mkdir -p "${HOME}/.local/bin"
ln -sfn "${eduvpn_env}/bin/eduvpn-cli" "${HOME}/.local/bin/eduvpn-cli"
eduvpn_user=$(id -un)
sudo usermod -aG eduvpn "${eduvpn_user}"
status_done 'eduVPN is ready (new sessions receive network permissions)'

status_start 'Setting up Bun'
if command -v bun >/dev/null 2>&1; then
    bun upgrade
else
    curl -fsSL https://bun.com/install |
        BUN_INSTALL="${HOME}/.bun" SHELL=/bin/sh bash
fi
status_done 'Bun is ready'

status_start 'Setting up Codex'
curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
status_done 'Codex is ready'

machine=$(uname -m)

status_start 'Setting up Typst'
typst_latest=$(github_latest typst/typst)
install_release \
    typst \
    "${typst_latest}" \
    "https://github.com/typst/typst/releases/latest/download/typst-${machine}-unknown-linux-musl.tar.xz" \
    typst \
    1
status_done 'Typst is ready'

status_start 'Setting up Tectonic'
tectonic_latest=$(
    curl -fsSL https://github.com/tectonic-typesetting/tectonic/releases.atom |
        grep -oE 'releases/tag/tectonic(@|%40)[0-9A-Za-z.+_-]*' |
        head -1 |
        sed 's|.*/||; s|.*%40||; s|.*@||'
)
install_release \
    tectonic \
    "${tectonic_latest}" \
    "https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic@${tectonic_latest}/tectonic-${tectonic_latest}-${machine}-unknown-linux-musl.tar.gz" \
    tectonic
status_done 'Tectonic is ready'

status_start 'Setting up Claude'
if command -v claude >/dev/null 2>&1; then
    claude update
else
    curl -fsSL https://claude.ai/install.sh | bash
fi
status_done 'Claude is ready'

status_start 'Setting up OpenCode'
if command -v opencode >/dev/null 2>&1; then
    opencode upgrade
else
    curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path
fi
status_done 'OpenCode is ready'

status_start 'Setting up Herdr'
curl -fsSL https://herdr.dev/install.sh | sh
status_done 'Herdr is ready'
