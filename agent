    return f"{HOME_VOLUME_PREFIX}{username}"


def mount_digest(mount_root: Path) -> str:
    """Short stable digest of the mounted root, keying per-repo state."""
    return hashlib.sha256(str(mount_root).encode()).hexdigest()[:12]


def run_container_name(username: str, mount_root: Path) -> str:
    """Per-repo persistent container name, keyed by the user and mounted root."""
    return f"{RUN_CONTAINER_PREFIX}{username}-{mount_digest(mount_root)}"


VENV_SCAN_DEPTH = 4
VENV_SCAN_SKIP = {".git", "node_modules"}


def host_venvs(mount_root: Path) -> list[str]:
    """Container paths of every `.venv` directory in the workspace, to be masked
    with an empty tmpfs: a host venv is the wrong platform, and the container's own
    lives on the home volume (see `project_env_dir`)."""
    found: list[str] = []

    def walk(directory: Path, depth: int) -> None:
        try:
            entries = sorted(directory.iterdir())
        except OSError:
            return
        for entry in entries:
            if not entry.is_dir() or entry.is_symlink():
                continue
            if entry.name == ".venv":
                found.append(str(entry))
            elif entry.name not in VENV_SCAN_SKIP and depth < VENV_SCAN_DEPTH:
                walk(entry, depth + 1)

    walk(mount_root, 1)
    return found


def project_env_dir(mount_root: Path) -> str:
    """Per-repo uv project environment on the home volume, so the venv lives on
    the container's own disk instead of the bind-mounted workspace."""
    return f"{CONTAINER_HOME}/.venvs/{mount_digest(mount_root)}"


