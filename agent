def resolve_mount_root(settings: Settings) -> Path:
    cwd = Path.cwd().resolve()
    if settings.mount_mode == "repo_root":
        return resolve_repo_root(cwd, Path.home().resolve())
    return cwd


def resolve_repo_root(pwd: Path, home: Path) -> Path:
    """Walk up from pwd for an ancestor containing `.git` (dir or file),
    bounded by home (exclusive). Return the first match, or pwd if none.
    `$HOME` itself is never returned even if it contains `.git` — otherwise
    a dotfiles-as-git-repo setup would mount the whole home directory."""
    p = pwd
    while p != home:
        if (p / ".git").exists():
            return p
        parent = p.parent
        if parent == p:
            break
        try:
            parent.relative_to(home)
        except ValueError:
            break
        p = parent
    return pwd


@dataclass(frozen=True)
class RunSpec:
    """Everything fixed at container-create time. `fingerprint` folds it (plus the
    current image id) into the `agent.fingerprint` label so any drift — mounts, env,
    user, ulimits, or a rebuilt image — forces a recreate."""

    name: str
    image: str
    image_id: str
    user: str
    mounts: list[str]
    env: list[str]
    tmpfs: list[str] = field(default_factory=list)
    ulimit: str = "nofile=524288:524288"
    memswap: str = "-1"

    @property
    def fingerprint(self) -> str:
        payload = json.dumps(
            {
                "image_id": self.image_id,
                "mounts": sorted(self.mounts),
                "tmpfs": sorted(self.tmpfs),
                "env": sorted(self.env),
                "user": self.user,
                "ulimit": self.ulimit,
                "memswap": self.memswap,
            },
            sort_keys=True,
        )
        return hashlib.sha256(payload.encode()).hexdigest()[:16]


def build_run_spec(engine: str, settings: Settings, image: str, mount_root: Path) -> RunSpec:
    """Construct the per-repo RunSpec (mounts, env, user, image id) the run path uses.
    Read-only/observational, so `agent doctor` can call it to predict drift with no
    side effects and its fingerprint matches the one `main` creates the container with."""
    uid, gid = os.getuid(), os.getgid()
    username = current_username()

    mount_specs = [
        f"{mount_root}:{mount_root}",
        # The shared, persistent home volume. It is intentionally writable by the
        # interactive agent user: native tools manage normal user-level state here.
        f"{home_volume(username)}:{CONTAINER_HOME}",
    ]
    if Path("/etc/localtime").is_file():
        mount_specs.append("/etc/localtime:/etc/localtime:ro")
    # Host git puts the credential-cache socket under $XDG_CACHE_HOME (default
    # ~/.cache); mount from there so it lines up with the daemon's actual path.
    host_cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    cred_cache = host_cache / "git/credential"
    if cred_cache.is_dir():
        mount_specs.append(f"{cred_cache}:{CONTAINER_HOME}/.cache/git/credential")
    for mount in settings.shared_host_paths:
        host_path = Path(mount.host).expanduser()
        if not host_path.exists():
            continue
        mount_specs.append(f"{host_path}:{mount.container}:ro")

    # Env is fixed at container-create time (not per invocation). All entries are
    # static KEY=value from settings; a bare pass-through name would freeze its
    # value at create until `agent stop`.
    env_values = list(settings.env_vars)
    env_values.append(f"UV_PROJECT_ENVIRONMENT={project_env_dir(mount_root)}")

    # SSH agent forwarding — key never enters the container.
    # macOS + Docker Desktop: socket injected by Docker Desktop at a fixed path.
    # Linux: forward the host socket via bind-mount.
    if sys.platform == "darwin":
        env_values.append("SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock")
    else:
        ssh_sock = os.environ.get("SSH_AUTH_SOCK", "")
        if ssh_sock and Path(ssh_sock).is_socket():
            mount_specs.append(f"{ssh_sock}:{ssh_sock}")
            env_values.append(f"SSH_AUTH_SOCK={ssh_sock}")

    return RunSpec(
        name=run_container_name(username, mount_root),
        image=image,
        image_id=_image_id(engine, image),
        user=f"{uid}:{gid}",
        mounts=mount_specs,
        env=env_values,
        tmpfs=host_venvs(mount_root),
    )


def _inspect_run_container(engine: str, name: str) -> tuple[bool, str] | None:
    """Return (running, fingerprint) for the named container, or None if absent.
    One inspect yields existence, run state, and the stored fingerprint together."""
    r = _run_text([engine, "inspect", "--format", '{{.State.Running}}\t{{index .Config.Labels "agent.fingerprint"}}', name])
    if r.returncode != 0:
        return None
    running_s, _, fp = r.stdout.strip().partition("\t")
    return running_s == "true", fp


def create_run_container(engine: str, spec: RunSpec) -> None:
    """Create the detached, idle persistent container. On a create race
    (another session claimed the name first), fall through if it now exists."""
    _progress(f"{_sty('1;34', '→')} Starting session container...")
    mount_flags = [arg for m in spec.mounts for arg in ("-v", m)]
    env_flags = [arg for e in spec.env for arg in ("-e", e)]
    tmpfs_flags = [arg for t in spec.tmpfs for arg in ("--tmpfs", t)]
    cmd = [
        engine,
        "run",
        "-d",
        "--name",
        spec.name,
        "--init",
        "--user",
        spec.user,
        f"--memory-swap={spec.memswap}",
        "--ulimit",
        spec.ulimit,
        *mount_flags,
        *tmpfs_flags,
        *env_flags,
        "--label",
        f"agent.fingerprint={spec.fingerprint}",
        spec.image,
        "sleep",
        "infinity",
    ]
    r = _run_quiet(cmd)
    if r.returncode != 0 and _inspect_run_container(engine, spec.name) is None:
        die(f"failed to create container {spec.name}:\n{r.stderr.decode(errors='replace').strip() or f'exit {r.returncode}'}")
    _progress(f"{_sty('1;32', '✓')} Session container ready.")


def ensure_run_container(engine: str, spec: RunSpec) -> None:
    """Create-or-reuse: one inspect drives absent/stale/stopped/running. A running
    container is never replaced — that would kill a live session — so a rebuild can
    only ever take effect the next time the container is (re)created."""
    state = _inspect_run_container(engine, spec.name)
    if state is not None and state[0]:
        if state[1] != spec.fingerprint:
            warn(
                f"{spec.name} config changed but a session is still running; "
                f"joining the existing (outdated) container instead of recreating it. "
                f"Run `agent stop` once no session is active to pick up the new config."
            )
        return
    if state is None:
        create_run_container(engine, spec)
    elif state[1] != spec.fingerprint:
        # Stopped and stale (e.g. after an image rebuild) → tear down and recreate.
        _run_quiet([engine, "rm", "-f", spec.name])
        create_run_container(engine, spec)
    else:
        _progress(f"{_sty('1;34', '→')} Restarting session container...")
        _run_quiet([engine, "start", spec.name])
        _progress(f"{_sty('1;32', '✓')} Session container ready.")


def warn_on_apt_drift(engine: str, image: str, settings: Settings) -> None:
    """Ordinary launches never build; they only point out that the running image
    was made from a different package selection than settings now describe."""
    baked = image_apt_fingerprint(engine, image)
    wanted = apt_fingerprint(settings.apt_packages)
    if baked is not None and baked != wanted:
        warn(f"image {image} was built from a different Debian package selection; run `agent build` to refresh it")


def run_stop(engine: str, mount_root: Path, *, all_repos: bool) -> None:
    """`agent stop`: full teardown (rm -f) to release the name and unpin the image.
    `--all` sweeps every visible persistent container, regardless of username, so a
    shared Docker host can be cleaned up comprehensively."""
    if all_repos:
        names = _list_run_containers(engine)
        if not names:
            print(f"{_sty('2', '•')} No persistent containers to stop.")
            return
        _clean_step(f"Removing {len(names)} persistent container(s)", [engine, "rm", "-f", *names])
        return
    name = run_container_name(current_username(), mount_root)
    _clean_step(f"Stopping {name}", [engine, "rm", "-f", name], missing_ok=True)


def run_clean(engine: str, *, force: bool = False) -> None:
    """Reclaim stopped sessions and unused images across every visible user.
    Persistent home volumes are never touched: they hold credentials, tool
    installations, and caches, so deleting them is left to Docker's own explicit
    volume commands."""
    all_names = _list_run_containers(engine)
    running = set(_list_run_containers(engine, running_only=True))
    if force:
        if all_names:
            warn(f"removing persistent container(s), killing any live session: {', '.join(all_names)}")
            _clean_step(f"Removing {len(all_names)} persistent container(s)", [engine, "rm", "-f", *all_names])
        else:
            print(f"{_sty('2', '•')} No persistent containers to remove.")
    else:
        stopped = [n for n in all_names if n not in running]
        if stopped:
            _clean_step(f"Removing {len(stopped)} stopped container(s)", [engine, "rm", "-f", *stopped])
        elif all_names:
            print(f"{_sty('2', '•')} Leaving {len(all_names)} live session(s) untouched (use --force to reclaim).")
        else:
            print(f"{_sty('2', '•')} No stopped containers to remove.")

    _reclaim_images(engine)
    print(f"{_sty('1;32', '✓')} Clean finished.")


def _reclaim_images(engine: str) -> None:
    """Remove every visible `agent:*` image no container still references."""
    in_use = _images_in_use(engine)
    r = _run_text([engine, "images", "--format", "{{.Repository}}:{{.Tag}}\t{{.ID}}", IMAGE_PREFIX.rstrip(":")])
    if r.returncode != 0:
        warn(f"could not list agent images: {r.stderr.strip() or f'exit {r.returncode}'}")
        return
    rows = [line.split("\t", 1) for line in r.stdout.splitlines() if "\t" in line]
    skipped = [tag for tag, iid in rows if short_id(iid) in in_use]
    tags = [tag for tag, iid in rows if short_id(iid) not in in_use]
    if skipped:
        print(f"{_sty('2', '•')} Skipping in-use images: {', '.join(skipped)}")
    if tags:
        _clean_step(f"Removing {len(tags)} unused agent image(s)", [engine, "rmi", *tags], missing_ok=True)
    else:
        print(f"{_sty('2', '•')} Removing agent images: nothing to do.")


