GROUP_SELECTED = "on"
GROUP_UNSELECTED = "off"
GROUP_PARTIAL = "partial"


def catalog_packages(groups: tuple[AptGroup, ...] = APT_GROUPS) -> set[str]:
    """Every package name the built-in catalog knows about."""
    return {p for g in groups for p in g.packages}


def default_apt_packages(groups: tuple[AptGroup, ...] = APT_GROUPS) -> list[str]:
    """The initial APT selection: every package in groups that default on."""
    return normalize_apt_packages({p for g in groups if g.default_on for p in g.packages})


def normalize_apt_packages(names: object) -> list[str]:
    """Canonical form of an APT selection: trimmed, de-duplicated, sorted. Both
    the fingerprint and the generated package list are built from this, so two
    settings files that select the same set always produce the same image."""
    if not isinstance(names, list | tuple | set | frozenset):
        return []
    cleaned = {n.strip() for n in names if isinstance(n, str) and n.strip()}
    return sorted(cleaned)


def apt_fingerprint(names: object) -> str:
    """Deterministic fingerprint of a normalized APT selection. Baked into the
    image at build time and re-derived from settings at launch, so drift between
    "what the image contains" and "what settings ask for" is observable."""
    payload = "\n".join(normalize_apt_packages(names))
    return hashlib.sha256(payload.encode()).hexdigest()[:16]


def group_state(group: AptGroup, selected: object) -> str:
    """Whether every, some, or no package of `group` is in the selection."""
    chosen = set(normalize_apt_packages(selected))
    present = [p for p in group.packages if p in chosen]
    if not present:
        return GROUP_UNSELECTED
    if len(present) == len(group.packages):
        return GROUP_SELECTED
    return GROUP_PARTIAL


def apply_group_states(
    selected: object,
    states: list[tuple[str, str]],
    groups: tuple[AptGroup, ...] = APT_GROUPS,
) -> list[str]:
    """Fold group toggles back into a flat package list. A group left `partial`
    keeps exactly the packages settings already selected (hand-edited selections
    survive an untouched setup run); `on` adds every member, `off` drops them all.
    Custom names outside the catalog are always preserved."""
    by_id = {g.id: g for g in groups}
    result = set(normalize_apt_packages(selected))
    for group_id, state in states:
        group = by_id.get(group_id)
        if group is None:
            continue
        if state == GROUP_SELECTED:
            result |= set(group.packages)
        elif state == GROUP_UNSELECTED:
            result -= set(group.packages)
    return normalize_apt_packages(result)


def custom_apt_packages(selected: object, groups: tuple[AptGroup, ...] = APT_GROUPS) -> list[str]:
    """Selected names the built-in catalog doesn't know. Setup preserves these
    untouched and never shows them in the group picker."""
    known = catalog_packages(groups)
    return [p for p in normalize_apt_packages(selected) if p not in known]


