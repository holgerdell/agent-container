#!/usr/bin/env bash
set -euo pipefail

instance="${AGENT_LIMA_INSTANCE:-agent-sandbox}"
disk=agent-sandbox-home
disk_size="${AGENT_LIMA_DISK_SIZE:-100GiB}"
if [[ -n ${AGENT_COMMAND+x} ]]; then
    case "${1:-}" in
    help | -h | --help) ;;
    *)
        echo "agent: AGENT_COMMAND was removed; use 'agent shell -- COMMAND...' to run commands in the VM" >&2
        exit 1
        ;;
    esac
fi
script_path=${BASH_SOURCE[0]}
while [[ -L ${script_path} ]]; do
    script_dir=$(cd -P -- "$(dirname -- "${script_path}")" && pwd)
    script_path=$(readlink "${script_path}")
    [[ ${script_path} = /* ]] || script_path="${script_dir}/${script_path}"
done
script_dir=$(cd -P -- "$(dirname -- "${script_path}")" && pwd)

usage() {
    cat <<'EOF'
Usage: agent [COMMAND] [ARGS...]

Open a shell in the Lima VM, in the guest copy of the current git repository.

Commands:
  agent                       Open a shell in the guest repo (mirrors host path)
  agent shell [--] COMMAND... Open a shell or run a command in the VM (in the guest repo)
  agent init                  Create and start the Lima VM
  agent git                   Show status of the 'agent' remote (read-only)
  agent update                Update system packages and user tools
  agent help                  Show this help

Other commands are passed through to limactl.

Environment:
  AGENT_LIMA_INSTANCE  Lima instance name (default: agent-sandbox)
  AGENT_LIMA_DISK_SIZE  Persistent disk size used by init (default: 100GiB)
EOF
}

require_limactl() {
    if ! command -v limactl >/dev/null 2>&1; then
        echo "agent: limactl is required but was not found on PATH" >&2
        exit 127
    fi
}

require_instance() {
    local instances
    instances=$(limactl list --quiet 2>/dev/null)
    if grep -Fqx "${instance}" <<<"${instances}"; then
        return
    fi
    echo "agent: Lima instance '${instance}' does not exist" >&2
    echo "Run 'agent init' to create it." >&2
    echo "If the VM already exists under another name, set AGENT_LIMA_INSTANCE to that name." >&2
    exit 1
}

open_shell() {
    local workdir home
    # shellcheck disable=SC2310 # fallback shells on failure must not exit
    if workdir=$(guest_workdir); then
        exec limactl shell --workdir "${workdir}" "${instance}" "$@"
    elif home=$(resolve_guest_home); then
        exec limactl shell --workdir "${home}" "${instance}" "$@"
    else
        exec limactl shell "${instance}" "$@"
    fi
}

resolve_guest_home() {
    local home
    # limactl shell passes arguments without a shell, so a literal '~'
    # would never expand on the guest. Resolve the guest home first.
    # shellcheck disable=SC2016 # $HOME must expand on the guest, not the host
    if ! home=$(limactl shell "${instance}" -- sh -c 'printf %s "$HOME"' 2>/dev/null) || [[ -z ${home} ]]; then
        return 1
    fi
    echo "${home}"
}

guest_workdir() {
    local repo_root slug host_dir rel guest_home guest_repo guest_dir
    # shellcheck disable=SC2310 # missing host repo means guest-home fallback, must not exit
    repo_root=$(find_git_root 2>/dev/null) || return 1
    slug=$(basename -- "${repo_root}")
    slug=${slug// /-}
    host_dir=$(pwd -P)
    if [[ ${host_dir} == "${repo_root}" ]]; then
        rel=""
    else
        rel=${host_dir#"${repo_root}/"}
    fi
    # shellcheck disable=SC2310 # unresolvable guest home means default directory, must not exit
    if ! guest_home=$(resolve_guest_home) || [[ -z ${guest_home} ]]; then
        echo "agent: warning: could not resolve guest home; opening shell in default directory" >&2
        return 1
    fi
    guest_repo="${guest_home}/src/${slug}"
    if ! limactl shell "${instance}" -- git -C "${guest_repo}" rev-parse --git-dir >/dev/null 2>&1; then
        echo "agent: warning: no repo at ${guest_repo} in '${instance}'; opening shell in guest home" >&2
        echo "Run 'agent git' to inspect host/guest sync status." >&2
        echo "${guest_home}"
        return 0
    fi
    if [[ -z ${rel} ]]; then
        echo "${guest_repo}"
        return 0
    fi
    guest_dir="${guest_repo}/${rel}"
    if limactl shell "${instance}" -- test -d "${guest_dir}" >/dev/null 2>&1; then
        echo "${guest_dir}"
    else
        echo "agent: warning: '${rel}' does not exist in guest repo; opening shell at repo root" >&2
        echo "${guest_repo}"
    fi
}

find_git_root() {
    # Walk up to the outermost repo: a ".git" file (worktree, submodule)
    # is skipped so the outer repository is used.
    local dir
    dir=$(pwd -P)
    while :; do
        if [[ -d "${dir}/.git" ]]; then
            echo "${dir}"
            return 0
        fi
        if [[ ${dir} == / ]]; then
            echo "agent: not inside a git repository" >&2
            exit 1
        fi
        dir=$(dirname -- "${dir}")
    done
}

summarize_porcelain() {
    local porcelain=$1 staged modified deleted untracked summary
    if [[ -z ${porcelain} ]]; then
        echo "clean"
        return
    fi
    staged=$(grep -c '^[MARCUDT]' <<<"${porcelain}" || true)
    modified=$(grep -c '^.[MT]' <<<"${porcelain}" || true)
    deleted=$(grep -c '^.D' <<<"${porcelain}" || true)
    untracked=$(grep -c '^??' <<<"${porcelain}" || true)
    summary=""
    if ((staged > 0)); then summary+="${staged} staged, "; fi
    if ((modified > 0)); then summary+="${modified} modified, "; fi
    if ((deleted > 0)); then summary+="${deleted} deleted, "; fi
    if ((untracked > 0)); then summary+="${untracked} untracked, "; fi
    echo "dirty (${summary%, })"
}

case "${1:-}" in
"")
    require_limactl
    require_instance
    open_shell
    ;;
init)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent init" >&2
        exit 2
    fi
    require_limactl
    instances=$(limactl list --quiet 2>/dev/null)
    if grep -Fqx "${instance}" <<<"${instances}"; then
        limactl start --yes --progress "${instance}"
    else
        if ! limactl disk list --json 2>/dev/null | grep -Fq '"name":"'"${disk}"'"'; then
            limactl disk create "${disk}" --size "${disk_size}"
        fi
        limactl start --yes --progress --name="${instance}" "${script_dir}/lima.yaml"
    fi
    printf '\nTry one of these commands:\n'
    printf '  agent        # open a shell in the guest repo\n'
    printf '  agent shell  # open a shell in the VM (in the guest repo)\n'
    ;;
shell)
    shift
    require_limactl
    require_instance
    open_shell "$@"
    ;;
git)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent git" >&2
        exit 2
    fi
    require_limactl
    require_instance
    repo_root=$(find_git_root)
    slug=$(basename -- "${repo_root}")
    slug=${slug// /-}
    if remote_url=$(git -C "${repo_root}" remote get-url agent 2>/dev/null); then
        remote_present=true
        if [[ ${remote_url} == "ext::limactl shell ${instance} -- %S ~/src/${slug}" ]]; then
            remote_info="set up (limactl shell ${instance})"
        else
            remote_info="${remote_url}"
        fi
    else
        remote_present=false
        remote_info="not set up"
    fi
    printf '%-12s %s\n' "agent remote" "${remote_info}"
    # limactl shell passes arguments without a shell, so a literal '~'
    # would never expand on the guest. Resolve the guest home first.
    # shellcheck disable=SC2016 # $HOME must expand on the guest, not the host
    if guest_home=$(limactl shell "${instance}" -- sh -c 'printf %s "$HOME"' 2>/dev/null) && [[ -n ${guest_home} ]]; then
        guest_repo="${guest_home}/src/${slug}"
    else
        guest_repo=""
    fi
    printf '%-12s %s\n' "guest path" "${guest_repo:-~/src/${slug}}"
    host_status=$(git -C "${repo_root}" status --porcelain)
    host_summary=$(summarize_porcelain "${host_status}")
    printf '%-12s %s\n' "host" "${host_summary}"
    if [[ -z ${guest_repo} ]]; then
        printf '%-12s %s\n' "guest" "unreachable (is the VM running?)"
    elif limactl shell "${instance}" -- git -C "${guest_repo}" rev-parse --git-dir >/dev/null 2>&1; then
        guest_status=$(limactl shell "${instance}" -- git -C "${guest_repo}" status --porcelain)
        guest_summary=$(summarize_porcelain "${guest_status}")
        printf '%-12s %s\n' "guest" "${guest_summary}"
    else
        printf '%-12s %s\n' "guest" "no repo at ${guest_repo}"
    fi
    if [[ ${remote_present} == false ]]; then
        printf '%-12s %s\n' "refs" "unknown (agent remote not set up)"
        exit 0
    fi
    # ls-remote queries the guest without updating local refs or configs.
    if ! guest_raw=$(git -C "${repo_root}" -c protocol.ext.allow=always ls-remote agent 2>&1); then
        echo "agent: failed to query guest refs" >&2
        echo "${guest_raw}" >&2
        exit 1
    fi
    local_refs=$(git -C "${repo_root}" for-each-ref --format='%(refname) %(objectname)' refs/heads refs/tags | grep -v '\^{}' || true)
    guest_refs=$(awk '$2 ~ /^refs\/(heads|tags)\// && $2 !~ /\^{}$/ {print $2" "$1}' <<<"${guest_raw}" | sort)
    diverged=$(awk '
        NF == 0 { next }
        NR == FNR { local_ref[$1] = $2; next }
        { guest_ref[$1] = $2 }
        END {
            count = 0
            for (ref in local_ref) {
                if (!(ref in guest_ref)) { print "  " ref " (only on host)"; count++ }
            }
            for (ref in guest_ref) {
                if (!(ref in local_ref)) { print "  " ref " (only in guest)"; count++ }
                else if (guest_ref[ref] != local_ref[ref]) { print "  " ref " (diverged)"; count++ }
            }
            if (count == 0) { print "all clean" }
        }' <(printf '%s\n' "${local_refs}") <(printf '%s\n' "${guest_refs}"))
    if [[ ${diverged} == "all clean" ]]; then
        printf '%-12s %s\n' "refs" "all clean"
    else
        diverged_count=$(grep -c '^  ' <<<"${diverged}" || true)
        printf '%-12s %s\n' "refs" "diverged (${diverged_count})"
        echo "${diverged}"
    fi
    # The ext:: remote needs protocol.ext.allow; drop the flag once it is configured.
    ext_allow=$(git -C "${repo_root}" config --get protocol.ext.allow || true)
    if [[ ${ext_allow} == "always" ]]; then
        ext_opt=""
    else
        ext_opt="-c protocol.ext.allow=always "
    fi
    printf '\nTo pull everything from guest to host, fast-forward the current branch:\n'
    # shellcheck disable=SC2016 # command text for the user; must stay literal
    printf '  git %s\n' "${ext_opt}"'pull --ff-only agent $(git branch --show-current)'
    printf 'To push everything from host to guest, push all branches and tags:\n'
    printf '  git %s\n' "${ext_opt}""push agent 'refs/heads/*:refs/heads/*' 'refs/tags/*:refs/tags/*'"
    ;;
update)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent update" >&2
        exit 2
    fi
    require_limactl
    require_instance
    lock_name=${instance//[^[:alnum:]._-]/_}
    lock_dir="${TMPDIR:-/tmp}/agent-update-${UID}-${lock_name}.lock"
    if ! mkdir "${lock_dir}" 2>/dev/null; then
        echo "agent: update already running for Lima instance '${instance}'" >&2
        exit 1
    fi
    trap 'rmdir "${lock_dir}"' EXIT
    limactl shell --start "${instance}" -- \
        sudo rm -f /var/lib/lima/package-provision-complete
    limactl shell "${instance}" -- sudo bash -s <"${script_dir}/install-system"
    limactl shell "${instance}" -- bash -s <"${script_dir}/install-tools"
    ;;
help | -h | --help)
    usage
    ;;
--)
    echo "agent: 'agent --' was removed; use 'agent shell -- COMMAND...' to run commands in the VM" >&2
    exit 2
    ;;
*)
    require_limactl
    exec limactl "$@"
    ;;
esac
