def nix_shared_volume(username: str) -> str:
    """The per-user shared /nix volume name, keyed by `whoami`."""
    return f"{NIX_SHARED_VOLUME_PREFIX}{username}"


def parse_generation(profile_link_target: str) -> int | None:
    """Parse N from a `default-N-link` profile-generation target (a bare link
    name or a full path). None if it isn't a generation link."""
    m = re.match(r"(?:.*/)?default-(\d+)-link$", profile_link_target.strip())
    return int(m.group(1)) if m else None


def generations_to_delete(all_gens: list[int], current: int, live_gens: list[int]) -> list[int]:
    """Gentle-GC retention: keep the current generation and every generation
    with number >= the oldest live session's recorded generation; delete the
    rest. With no live session, keep only the current generation. (A long job
    can span two upgrades and run on a generation that is neither its session's
    start-generation nor the current one, so we keep the whole tail from the
    oldest-live floor up.)"""
    floor = min(live_gens) if live_gens else current
    return sorted(g for g in all_gens if g < floor and g != current)


def session_roots_to_reap(root_names: list[str], running: set[str]) -> list[str]:
    """Session gcroots whose container is not currently running. Keying on
    *not-running* (rather than *absent*) unifies clean-stop, crash-exit, and
    removal — a stopped container has no live processes to protect, and a crash
    can't leak a permanent root."""
    reap: list[str] = []
    for r in root_names:
        if not r.startswith(SESSION_GCROOT_PREFIX):
            continue
        if r[len(SESSION_GCROOT_PREFIX) :] not in running:
            reap.append(r)
    return reap


@dataclass(frozen=True)
class SharedMount:
    """A host path mounted read-only into the container. `builtin` marks an
    allowlist entry (persisted compactly as a bare host string); a custom mount
    persists as a `{host, container}` object."""

    host: str
    container: str
    builtin: bool

    def __str__(self) -> str:
        return self.host if self.builtin else f"{self.host} -> {self.container}"

    def to_json(self) -> str | dict[str, str]:
        return self.host if self.builtin else {"host": self.host, "container": self.container}


@dataclass(frozen=True)
class CodingAgent:
    """A selectable coding agent `agent` can launch by default. `id` is both the
    settings key and the binary name; `args` are the fixed launch flags
    (approvals policy) appended before any user-supplied `--` extras."""

    id: str
    label: str
    args: tuple[str, ...] = ()
    description: str = ""


# The coding agents baked into the toolchain that `agent` can launch. Each
# `args` is that agent's approvals flag — the container itself is the sandbox,
# so approvals are skipped on launch. claude and codex also bypass their own
# sandbox (claude `--dangerously-skip-permissions`, codex
# `--dangerously-bypass-approvals-and-sandbox`); opencode `--auto` and vibe
# `--auto-approve` auto-approve tool calls in-session. `ollama` is a model
# server, not an interactive coding agent, so it's absent here.
AGENTS: tuple[CodingAgent, ...] = (
    CodingAgent(
        "claude",
        "Claude Code",
        ("--dangerously-skip-permissions",),
        "Anthropic's official CLI coding agent.",
    ),
    CodingAgent(
        "codex",
        "Codex",
        ("--dangerously-bypass-approvals-and-sandbox",),
        "OpenAI's CLI coding agent. Sandbox and approvals are bypassed since the container is the sandbox.",
    ),
    CodingAgent(
        "opencode",
        "OpenCode",
        ("--auto",),
        "Open-source coding agent. Permissions are auto-approved since the container is the sandbox.",
    ),
    CodingAgent(
        "vibe",
        "Mistral Vibe",
        ("--auto-approve",),
        "Mistral's CLI coding agent. Tool calls are auto-approved since the container is the sandbox.",
    ),
)
DEFAULT_AGENT_ID = "claude"


def _is_known_agent(agent_id: object) -> bool:
    return isinstance(agent_id, str) and any(a.id == agent_id for a in AGENTS)


def _agent_by_id(agent_id: str) -> CodingAgent:
    for a in AGENTS:
        if a.id == agent_id:
            return a
    # A stale settings file from a removed agent: fall back to the default
    # rather than die, mirroring mount_mode's lenient handling.
    return next(a for a in AGENTS if a.id == DEFAULT_AGENT_ID)


@dataclass(frozen=True)
class Settings:
    mount_mode: str = "repo_root"
    coding_agent: str = DEFAULT_AGENT_ID
    shared_host_paths: list[SharedMount] = field(default_factory=list)
    env_vars: list[str] = field(default_factory=list)

    def to_json(self) -> dict[str, Any]:
        return {
            "mount_mode": self.mount_mode,
            "coding_agent": self.coding_agent,
            "shared_host_paths": [m.to_json() for m in self.shared_host_paths],
            "env_vars": list(self.env_vars),
        }


def _color_for(stream: TextIO) -> bool:
    if os.environ.get("NO_COLOR"):
        return False
    if os.environ.get("FORCE_COLOR"):
        return True
    return stream.isatty()


_OUT_COLOR = _color_for(sys.stdout)
_ERR_COLOR = _color_for(sys.stderr)


def _sty(code: str, text: str, *, err: bool = False) -> str:
    enabled = _ERR_COLOR if err else _OUT_COLOR
    return f"\033[{code}m{text}\033[0m" if enabled else text


def _bold(s: str) -> str:
    return _sty("1", s)


# Semantic colour helpers (shared CLI style). Backed by `_sty` so NO_COLOR /
# FORCE_COLOR / tty-detection all keep working through one code path.
def _c(s: str, code: str) -> str:
    return _sty(code, s)


def dim(s: str) -> str:
    return _c(s, "2")


def bold(s: str) -> str:
    return _c(s, "1")


def cyan(s: str) -> str:
    return _c(s, "36")


def green(s: str) -> str:
    return _c(s, "32")


def yellow(s: str) -> str:
    return _c(s, "33")


def red(s: str) -> str:
    return _c(s, "31")


def _progress(msg: str, *, file: TextIO = sys.stdout) -> None:
    """Print one 'this is starting' line and flush it immediately. Without the
    explicit flush, a line printed right before a slow subprocess call can sit in
    Python's block buffer — invisible — until the buffer fills or the program
    exits, which defeats the point of printing it early whenever stdout/stderr
    isn't a TTY (piped through `tee`, redirected to a log, etc)."""
    print(msg, file=file)
    file.flush()


_KEY_UP = "up"
_KEY_DOWN = "down"
_KEY_SPACE = "space"
_KEY_ENTER = "enter"
_KEY_CANCEL = "cancel"
_KEY_OTHER = "other"


def _tty_required() -> None:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("setup requires an interactive terminal (stdin/stdout must be a TTY)")


@contextlib.contextmanager
def _raw_mode() -> Iterator[None]:
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    sys.stdout.write("\x1b[?25l")
    sys.stdout.flush()
    try:
        tty.setcbreak(fd)
        mode = termios.tcgetattr(fd)
        mode[3] &= ~termios.ISIG
        termios.tcsetattr(fd, termios.TCSANOW, mode)
        yield
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write("\x1b[?25h")
        sys.stdout.flush()


def _read_key() -> str:
    fd = sys.stdin.fileno()
    ch = os.read(fd, 1)
    if not ch or ch in (b"\x03", b"\x04"):
        return _KEY_CANCEL
    if ch in (b"\r", b"\n"):
        return _KEY_ENTER
    if ch == b" ":
        return _KEY_SPACE
    if ch in (b"k", b"K"):
        return _KEY_UP
    if ch in (b"j", b"J"):
        return _KEY_DOWN
    if ch == b"\x1b":
        ready, _, _ = select.select([fd], [], [], 0.05)
        if not ready or os.read(fd, 1) != b"[":
            return _KEY_OTHER
        ready, _, _ = select.select([fd], [], [], 0.05)
        if not ready:
            return _KEY_OTHER
        arrow = os.read(fd, 1)
        if arrow == b"A":
            return _KEY_UP
        if arrow == b"B":
            return _KEY_DOWN
    return _KEY_OTHER


_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def _visible_width(s: str) -> int:
    return len(_ANSI_RE.sub("", s))


def _physical_rows(text: str) -> int:
    cols = shutil.get_terminal_size((80, 24)).columns
    rows = 0
    for line in text.split("\n")[:-1]:
        rows += max(1, (_visible_width(line) + cols - 1) // cols)
    return rows


def _erase(rows: int) -> None:
    if rows <= 0:
        return
    sys.stdout.write(f"\x1b[{rows}F\x1b[J")
    sys.stdout.flush()


def tui_select[T](
    message: str,
    choices: list[tuple[str, T, str]],
    *,
    initial: T | None = None,
    summary_message: str | None = None,
) -> T | None:
    _tty_required()
    if not choices:
        return None

    qmark = _sty("1;34", "?")
    pointer = _sty("1;34", "❯ ")

    idx = 0
    if initial is not None:
        for i, (_, value, _) in enumerate(choices):
            if value == initial:
                idx = i
                break
    rendered = 0
    final_message = summary_message or message

    def render(final_label: str | None = None) -> None:
        nonlocal rendered
        _erase(rendered)
        prompt = final_message if final_label is not None else message
        out = [f"{qmark} {_bold(prompt)}"]
        if final_label is None:
            out.append("\n")
            for i, (label, _, _) in enumerate(choices):
                if i == idx:
                    prefix = pointer
                    radio = _sty("34", "●")
                else:
                    prefix = "  "
                    radio = "○"
                out.append(f"{prefix}{radio} {label}\n")
            out.append("\n")
            for line in choices[idx][2].splitlines():
                out.append(f"  {_sty('2', line)}\n")
        else:
            out.append(f" {_sty('34', final_label)}\n")
        text = "".join(out)
        sys.stdout.write(text)
        sys.stdout.flush()
        rendered = _physical_rows(text)

    with _raw_mode():
        render()
        while True:
            key = _read_key()
            if key == _KEY_CANCEL:
                _erase(rendered)
                return None
            if key == _KEY_ENTER:
                label, value, _ = choices[idx]
                render(final_label=label)
                return value
            if key == _KEY_UP:
                idx = (idx - 1) % len(choices)
                render()
            elif key == _KEY_DOWN:
                idx = (idx + 1) % len(choices)
                render()


def tui_checkbox[T](
    message: str,
    choices: list[tuple[str, T, bool]],
    *,
    summary_message: str | None = None,
    details: str | None = None,
) -> list[T] | None:
    _tty_required()
    if not choices:
        return []

    qmark = _sty("1;34", "?")
    pointer = _sty("1;34", "❯ ")
    approve_label = "Submit selection"
    approve_idx = len(choices)

    idx = approve_idx
    checked = [c for _, _, c in choices]
    rendered = 0
    final_message = summary_message or message

    def render(final: bool = False) -> None:
        nonlocal rendered
        _erase(rendered)
        prompt = final_message if final else message
        out = [f"{qmark} {_bold(prompt)}"]
        if final:
            picked = [str(v) for (_, v, _), c in zip(choices, checked, strict=True) if c]
            answer = ", ".join(picked) if picked else "(none)"
            out.append(f" {_sty('34', answer)}\n")
        else:
            out.append("\n")
            if details is not None:
                for line in details.splitlines():
                    out.append(f"  {_sty('2', line)}\n")
                out.append("\n")
            for i, (label, _, _) in enumerate(choices):
                prefix = pointer if i == idx else "  "
                box = "[x]" if checked[i] else "[ ]"
                if checked[i]:
                    box = _sty("34", box)
                out.append(f"{prefix}{box} {label}\n")
            out.append("\n")
            if idx == approve_idx:
                out.append(f"{pointer}{_sty('1;32', approve_label)}\n")
            else:
                out.append(f"  {approve_label}\n")
        text = "".join(out)
        sys.stdout.write(text)
        sys.stdout.flush()
        rendered = _physical_rows(text)

    with _raw_mode():
        render()
        while True:
            key = _read_key()
            if key == _KEY_CANCEL:
                _erase(rendered)
                return None
            if key in (_KEY_ENTER, _KEY_SPACE):
                if idx == approve_idx:
                    render(final=True)
                    return [v for (_, v, _), c in zip(choices, checked, strict=True) if c]
                checked[idx] = not checked[idx]
                render()
            elif key == _KEY_UP:
                idx = (idx - 1) % (len(choices) + 1)
                render()
            elif key == _KEY_DOWN:
                idx = (idx + 1) % (len(choices) + 1)
                render()


