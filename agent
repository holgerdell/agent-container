def registry_ids(registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> list[str]:
    return [p.id for p in registry]


def extra_by_id(pkg_id: str, registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> ExtraPackage | None:
    return next((p for p in registry if p.id == pkg_id), None)


def launchable_agents(registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> list[ExtraPackage]:
    """Registry entries that carry coding-agent launch metadata. Non-agent extras
    (formatters, package managers, model servers) are installable but never
    appear in the default-agent selector."""
    return [p for p in registry if p.agent is not None]


def remove_command(entry: ExtraPackage) -> str:
    """The removal routine: the upstream uninstaller when one exists, then a
    delete of exactly the paths this entry declares it owns. The unconditional
    path delete is what makes removal reliable when an uninstaller is missing or
    broken — and it can only ever touch declared paths, never untracked files."""
    quoted = " ".join(f'"$HOME/{p}"' for p in entry.owned_paths)
    prefix = f"{entry.uninstall} || true\n" if entry.uninstall else ""
    return f"{prefix}rm -rf {quoted}\n"


# --- Extra-package versions ---------------------------------------------------

# Every managed tool answers `--version`, but each decorates the number
# differently ("uv 0.11.32 (aarch64…)", "typos-cli 1.48.0", a warning line before
# the number). The first version-shaped token in the output is the version.
_VERSION_RE = re.compile(r"\d+\.\d+[\w.+-]*")
VERSION_PROBE_MARKER = "# agent: report extra-package versions"


def version_probe_script(ids: list[str], registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> str:
    """One script that reports `id<TAB>raw --version output` for every requested
    package, so a whole report costs a single container run. A tool that is
    missing or whose `--version` fails simply reports nothing for that line."""
    specs = " ".join(f'"{e.id}:{e.executables[0]}"' for i in ids if (e := extra_by_id(i, registry)) and e.executables)
    return (
        f"{VERSION_PROBE_MARKER}\n"
        f"for spec in {specs}; do\n"
        '  id="${spec%%:*}"; exe="${spec#*:}"; out=""\n'
        '  command -v "$exe" >/dev/null 2>&1 && out=$("$exe" --version 2>&1 | tr "\\n" " ")\n'
        '  printf \'%s\\t%s\\n\' "$id" "$out"\n'
        "done\n"
    )


def parse_version_report(stdout: str) -> dict[str, str]:
    out: dict[str, str] = {}
    for line in stdout.splitlines():
        pkg, _, raw = line.partition("\t")
        match = _VERSION_RE.search(raw)
        if pkg.strip() and match:
            out[pkg.strip()] = match.group(0)
    return out


# --- Extra-package reconciliation: pure logic --------------------------------

ACTION_INSTALL = "install"
ACTION_UPDATE = "update"
ACTION_REMOVE = "remove"

RESULT_INSTALLED = "installed"
RESULT_UPDATED = "updated"
RESULT_REMOVED = "removed"
RESULT_SKIPPED = "skipped"
RESULT_FAILED = "failed"
# An update whose reported version did not move: upstream had nothing newer.
RESULT_UNCHANGED = "up to date"

_ACTION_RESULT = {
    ACTION_INSTALL: RESULT_INSTALLED,
    ACTION_UPDATE: RESULT_UPDATED,
    ACTION_REMOVE: RESULT_REMOVED,
}


@dataclass(frozen=True)
class ExtraOp:
    """One planned package operation, in stable registry order."""

    package_id: str
    action: str


def normalize_extra_packages(ids: object, registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> tuple[list[str], list[str]]:
    """Split a settings selection into (known ids, unknown ids). Unknown entries
    are reported to the caller so they can be warned about and then ignored —
    never executed."""
    if not isinstance(ids, list | tuple):
        return [], []
    known = set(registry_ids(registry))
    selected: list[str] = []
    unknown: list[str] = []
    for entry in ids:
        if not isinstance(entry, str) or not entry.strip():
            continue
        name = entry.strip()
        if name in known:
            if name not in selected:
                selected.append(name)
        elif name not in unknown:
            unknown.append(name)
    return selected, unknown


def plan_reconciliation(
    selected: object,
    managed: object,
    registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY,
) -> tuple[list[ExtraOp], list[str]]:
    """Decide what to do with every registry entry, walking the registry in its
    built-in order so behavior and logs are deterministic regardless of settings
    order. Returns (operations, unmanageable ids).

    - selected, not previously managed  → install
    - selected, previously managed      → update
    - previously managed, now deselected → remove
    - anything else (untracked user tools) → nothing at all

    The second return value is state entries naming packages the registry no
    longer knows: they cannot be safely removed (their owned paths are unknown),
    so they are reported and left alone."""
    chosen, _ = normalize_extra_packages(selected, registry)
    chosen_set = set(chosen)
    managed_set = {m for m in managed if isinstance(m, str)} if isinstance(managed, list | tuple | set | dict) else set()

    ops: list[ExtraOp] = []
    for entry in registry:
        if entry.id in chosen_set:
            ops.append(ExtraOp(entry.id, ACTION_UPDATE if entry.id in managed_set else ACTION_INSTALL))
        elif entry.id in managed_set:
            ops.append(ExtraOp(entry.id, ACTION_REMOVE))
    stale = sorted(managed_set - set(registry_ids(registry)))
    return ops, stale


def parse_extras_state(raw: Any) -> dict[str, dict[str, Any]]:
    """Read the persisted reconciliation state, tolerating anything malformed by
    degrading to "nothing managed" — an unreadable state file must never cause
    Agent to delete or re-install at random. A file written by a newer schema is
    treated the same way: unrecognized, so nothing in it is acted upon."""
    if not isinstance(raw, dict):
        return {}
    schema = raw.get("schema")
    if schema != EXTRAS_STATE_SCHEMA:
        warn(f"managed-extras state has unsupported schema {schema!r}; treating it as empty and leaving installed tools alone")
        return {}
    packages = raw.get("packages")
    if not isinstance(packages, dict):
        return {}
    out: dict[str, dict[str, Any]] = {}
    for key, value in packages.items():
        if not isinstance(key, str):
            continue
        status = value.get("status") if isinstance(value, dict) else None
        out[key] = {"status": status if isinstance(status, str) else RESULT_INSTALLED}
    return out


def extras_state_json(state: dict[str, dict[str, Any]]) -> str:
    return json.dumps({"schema": EXTRAS_STATE_SCHEMA, "packages": state}, indent=2, sort_keys=True) + "\n"


def apply_op_result(state: dict[str, dict[str, Any]], op: ExtraOp, ok: bool) -> dict[str, dict[str, Any]]:
    """Fold one operation's outcome into the managed-state map.

    A failed install or update is never recorded as a successful managed state; a
    failed removal *keeps* its entry, so the package stays deselected-but-managed
    and a later `agent update` retries the removal until it converges."""
    updated = {k: dict(v) for k, v in state.items()}
    if op.action == ACTION_REMOVE:
        if ok:
            updated.pop(op.package_id, None)
        else:
            updated[op.package_id] = {"status": "remove-failed"}
        return updated
    if ok:
        updated[op.package_id] = {"status": RESULT_INSTALLED}
    elif op.action == ACTION_UPDATE:
        # Still installed and still managed — just not currently up to date.
        updated[op.package_id] = {"status": RESULT_FAILED}
    else:
        updated.pop(op.package_id, None)
    return updated


def op_command(op: ExtraOp, registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> str | None:
    """The shell routine for one operation. Install and update are followed by a
    local verification that every executable the entry declares actually resolves
    on PATH, so an installer that "succeeds" without producing a working tool is
    reported as a failure instead of being recorded as managed.

    `set -e` leads, because otherwise only the routine's *last* command decides
    the exit status: a one-line routine that failed would still be recorded as
    managed whenever the executable it was supposed to update happened to remain
    on PATH — which is exactly the case where the old version is still there."""
    entry = extra_by_id(op.package_id, registry)
    if entry is None:
        return None
    if op.action == ACTION_REMOVE:
        return remove_command(entry)
    routine = entry.install if op.action == ACTION_INSTALL else entry.update
    checks = "".join(
        f'command -v {exe} >/dev/null || {{ echo "agent: {exe} not found on PATH after {op.action}" >&2; exit 1; }}\n'
        for exe in entry.executables
    )
    return f"set -e\n{routine.rstrip()}\n{checks}"


