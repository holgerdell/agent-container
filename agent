# `owned_paths` lists only what a package installs for itself, never a file it
# shares with another entry. The Astral installers, left to themselves, would
# write `~/.local/bin/env` and `~/.local/bin/env.fish` from uv, ruff, and ty
# alike — unassignable to any one package, and unsafe to claim for one because
# removing it would break the others. `INSTALLER_NO_MODIFY_PATH=1` stops them
# being created at all, since the image already owns PATH.
EXTRA_REGISTRY: tuple[ExtraPackage, ...] = (
    ExtraPackage(
        id="uv",
        label="uv",
        description="Astral's Python package and project manager.",
        install=_astral_install("uv"),
        # `self update` is the one uv subcommand that cares which uv runs it: it
        # refuses outright unless the binary matches the install receipt, so a
        # second uv earlier on PATH would fail the update instead of no-opping.
        # The other entries' `uv tool` commands are indifferent — they write to
        # the same XDG directories whichever uv serves them — so only this one
        # names an absolute path.
        update='"$HOME/.local/bin/uv" self update',
        owned_paths=(".local/bin/uv", ".local/bin/uvx"),
