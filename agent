def check_engine(engine: str) -> None:
    if not shutil.which(engine):
        die(f"{engine} not in PATH\nInstall: {_ENGINE_INSTALL_HINT[engine]}")

    if engine == "podman" and sys.platform == "darwin":
        r = subprocess.run(
            ["podman", "machine", "list", "--format", "{{.Running}}"],
            capture_output=True,
            text=True,
            check=False,
        )
        running = any(line.strip() == "true" for line in r.stdout.splitlines())
        if not running:
            die("no running podman machine\nRemediation: podman machine start")

    info = _run_quiet([engine, "info"])
    if info.returncode != 0:
        stderr = info.stderr.decode(errors="replace").strip()
        die(f"`{engine} info` failed:\n{stderr}")


def image_exists(engine: str, image: str) -> bool:
    if engine == "podman":
        cmd = ["podman", "image", "exists", image]
    else:
        cmd = ["docker", "image", "inspect", image]
    return _run_quiet(cmd).returncode == 0


def _volume_exists(engine: str, volume: str) -> bool:
    return _run_quiet([engine, "volume", "inspect", volume]).returncode == 0


def build_container_name(uid: int, gid: int) -> str:
    return f"agent-build-u{uid}g{gid}"


def _is_container_running(engine: str, name: str) -> bool:
    r = subprocess.run(
        [engine, "ps", "--filter", f"name={name}", "--format", "{{.Names}}"],
        capture_output=True,
        text=True,
        check=False,
    )
    return any(line.strip() == name for line in r.stdout.splitlines())


def _run_quiet(cmd: list[str]) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(cmd, capture_output=True, check=False)


def _clean_step(label: str, cmd: list[str], *, missing_ok: bool = False) -> None:
    print(f"{_sty('1;34', '→')} {label}...")
    r = _run_quiet(cmd)
    stderr = r.stderr.decode(errors="replace").strip()
    if r.returncode == 0:
        print(f"{_sty('1;32', '✓')} {label}.")
        return
    if missing_ok:
        missing_markers = (
            "No such image",
            "No such object",
            "No such volume",
            "not found",
        )
        if any(marker in stderr for marker in missing_markers):
            print(f"{_sty('2', '•')} {label}: already absent.")
            return
    warn(f"{label} failed: {stderr or f'exit {r.returncode}'}")


def _images_in_use(engine: str) -> set[str]:
    """Return short image ids currently in use by running containers."""
    r = subprocess.run(
        [engine, "ps", "-aq", "--no-trunc"],
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return set()
    container_ids = [c.strip() for c in r.stdout.splitlines() if c.strip()]
    ri = subprocess.run(
        [engine, "inspect", "--format", "{{.Image}}", *container_ids],
        capture_output=True,
        text=True,
        check=False,
    )
    image_ids: set[str] = set()
    if ri.returncode == 0:
        for raw in ri.stdout.splitlines():
            raw = raw.strip()
            if raw:
                image_ids.add(raw.removeprefix("sha256:")[:12])
    return image_ids


def run_clean(engine: str) -> None:
    in_use_ids = _images_in_use(engine)

    print(f"{_sty('1;34', '→')} Inspecting agent images...")
    r = subprocess.run(
        [engine, "images", "--format", "{{.Repository}}:{{.Tag}}\t{{.ID}}", "agent"],
        capture_output=True,
        text=True,
        check=False,
    )
    if r.returncode != 0:
        die(f"could not list agent images:\n{r.stderr.strip() or f'exit {r.returncode}'}")

    tag_rows: list[tuple[str, str]] = []
    for line in r.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        parts = line.split("\t", 1)
        if len(parts) == 2:
            tag_rows.append((parts[0], parts[1]))
    skipped_tags = [tag for tag, img_id in tag_rows if img_id[:12] in in_use_ids]
    tags = [tag for tag, img_id in tag_rows if img_id[:12] not in in_use_ids]
    if skipped_tags:
        print(f"{_sty('2', '•')} Skipping in-use images: {', '.join(skipped_tags)}")
    if tags:
        print(f"{_sty('2', '•')} Found images: {', '.join(tags)}")
        _clean_step("Removing agent images", [engine, "rmi", *tags], missing_ok=True)
    else:
        print(f"{_sty('2', '•')} Removing agent images: nothing to do.")

    # Reclaim orphaned image tarballs from the nix build cache. Each build
    # leaves a ~3G `-agent.tar.zst` behind; only the ones the gcroots point at
    # (the current per-uid images) are still needed. Deleting the rest via
    # `nix-store --delete` never touches the toolchain closure, so rebuilds
    # stay fast — unlike a blanket `nix-collect-garbage`.
    if _volume_exists(engine, NIX_BUILD_CACHE_VOLUME):
        reclaim = r'''
            keep=$(for r in /nix/var/nix/gcroots/agent-image-*; do readlink "$r" 2>/dev/null; done)
            victims=""
            for t in /nix/store/*-agent.tar.gz /nix/store/*-agent.tar.zst; do
              [ -e "$t" ] || continue
              case " $keep " in *" $t "*) ;; *) victims="$victims $t" ;; esac
            done
            if [ -n "$victims" ]; then nix-store --delete $victims; else echo "no orphaned tarballs"; fi
        '''
        _clean_step(
            "Reclaiming build cache",
            [engine, "run", "--rm", "-v", f"{NIX_BUILD_CACHE_VOLUME}:/nix", NIX_IMAGE, "sh", "-c", reclaim],
        )
    print(f"{_sty('1;32', '✓')} Clean finished.")


def build(engine: str, image: str) -> None:
    uid, gid = os.getuid(), os.getgid()
    build_name = build_container_name(uid, gid)
    if _is_container_running(engine, build_name):
        print(f"{_sty('1;34', '→')} Another build is already running ({build_name}); waiting for it to finish...")
        r = subprocess.run([engine, "wait", build_name], capture_output=True, text=True, check=False)
        if r.returncode != 0:
            die(f"failed to wait for concurrent build {build_name}:\n{r.stderr.strip() or f'exit {r.returncode}'}")
        # `engine wait` prints the container's exit code(s) on stdout.
        failed = [code for code in r.stdout.strip().splitlines() if code and code != "0"]
        if failed:
            die(f"concurrent build {build_name} exited with status {failed[0]!r}; rerun `agent build`")
        # Peer's `engine load`/`engine tag` may still be in flight after the
        # container exits; if the image isn't yet visible, ask the user to retry.
        if not image_exists(engine, image):
            die(f"concurrent build {build_name} finished but image {image} is not yet tagged; rerun shortly")
        return
    # Clear any stopped leftover (e.g. from a crash) so `--name` can claim it.
    _run_quiet([engine, "rm", build_name])
    _run_quiet([engine, "volume", "create", NIX_BUILD_CACHE_VOLUME])

    # Cheap pre-check: realize the image derivation and print its store path
    # (seconds when the tarball is already cached, vs ~70s to stream and load
    # the multi-GB tarball). The store-path hash keys a marker tag
    # `agent:src-<hash>`; if that marker exists we've already loaded this exact
    # tarball, so we can skip `docker load` and just re-tag. Kept under the
    # `agent` repo so `agent clean`'s sweep removes markers too.
    #
    # AGENT_UID/AGENT_GID must match the build below: the image derivation
    # `chown`s to them, so a mismatch would realize a *different* image here
    # than we load, keying the marker on the wrong hash and building the image
    # twice. `--out-link` registers a gcroot so the current image (and its
    # whole toolchain closure, ~330 refs) survives `nix-collect-garbage`.
    gcroot = f"/nix/var/nix/gcroots/agent-image-u{uid}g{gid}"
    print(f"{_sty('1;34', '→')} Resolving image...")
    probe = subprocess.run(
        [
            engine, "run", "--rm", "--name", build_name,
            "-v", f"{NIX_BUILD_CACHE_VOLUME}:/nix",
            "-v", f"{SCRIPT_DIR / 'agent-image'}:/build:ro,z",
            "-e", f"AGENT_UID={uid}",
            "-e", f"AGENT_GID={gid}",
            NIX_IMAGE, "sh", "-c",
            f"mkdir -p /nix/var/nix/gcroots && nix build path:/build#image"
            f" --out-link {gcroot} --print-out-paths"
            " --impure --extra-experimental-features 'nix-command flakes'",
        ],
        capture_output=True, text=True, check=False,
    )
    if probe.returncode != 0:
        die(f"nix build failed (exit {probe.returncode}):\n{probe.stderr.strip() or '(no output)'}")
    out_path = probe.stdout.strip().splitlines()[-1] if probe.stdout.strip() else ""
    sm = re.match(r"/nix/store/([a-z0-9]+)-", out_path)
    if sm is None:
        die(f"could not parse nix store path from build output:\n{out_path or '(empty)'}")
    marker = f"agent:src-{sm.group(1)}"
    if image_exists(engine, marker):
        subprocess.run([engine, "tag", marker, image], check=True)
        print(f"{_sty('1;32', '✓')} Reused {marker}; tagged as {image}")
        return

    print(f"{_sty('1;34', '→')} Building...")
    build_proc = subprocess.Popen(
        [
            engine,
            "run",
            "--rm",
            "--name",
            build_name,
            "-v",
            f"{NIX_BUILD_CACHE_VOLUME}:/nix",
            "-v",
            f"{SCRIPT_DIR / 'agent-image'}:/build:ro,z",
            "-e",
            f"AGENT_UID={uid}",
            "-e",
            f"AGENT_GID={gid}",
            NIX_IMAGE,
            "sh",
            "-c",
            'cat "$(nix build path:/build#image --no-link --print-out-paths'
            " --impure --extra-experimental-features 'nix-command flakes')\"",
        ],
        stdout=subprocess.PIPE,
    )
    assert build_proc.stdout is not None
    print(f"{_sty('1;34', '→')} Loading...")
    load = subprocess.run(
        [engine, "load"],
        stdin=build_proc.stdout,
        capture_output=True,
        text=True,
        check=False,
    )
    build_proc.stdout.close()
    build_rc = build_proc.wait()
    if load.returncode != 0:
        # A truncated/corrupted stream shows up here first (e.g. unpigz:
        # "corrupted -- incomplete deflate data"). The usual cause is a bad
        # cached tarball in the build volume, which survives a plain retry —
        # the fix is to drop the volume and rebuild from scratch.
        recovery = f"{engine} volume rm {NIX_BUILD_CACHE_VOLUME} && agent build"
        die(
            f"{engine} load failed:\n{load.stderr.strip() or f'exit {load.returncode}'}\n"
            f"If this looks like a corrupted or truncated stream, reset the build "
            f"cache and retry:\n  {recovery}"
        )
    if build_rc != 0:
        die(f"nix build failed (exit {build_rc})")
    # podman prefixes loaded images with `localhost/`; docker does not.
    m = re.search(r"(?:localhost/)?agent:[a-z0-9]+", load.stdout)
    if m is None:
        die(f"could not extract image tag from `{engine} load` output:\n{load.stdout.strip() or '(empty)'}")
    subprocess.run([engine, "tag", m.group(0), image], check=True)
    subprocess.run([engine, "tag", m.group(0), marker], check=True)
    print(f"{_sty('1;32', '✓')} Tagged {m.group(0)} as {image}")
    # No volume removal: runtime volume name is derived from image ID at
    # `agent run`, so the new image gets its own fresh volume on first use.
    # Any agent still running against the previous image keeps its volume.


def run_update(engine: str) -> None:
    _run_quiet([engine, "volume", "create", NIX_BUILD_CACHE_VOLUME])
    print(f"{_sty('1;34', '→')} Updating flake.lock...")
    subprocess.run(
        [
            engine,
            "run",
            "--rm",
            "-v",
            f"{NIX_BUILD_CACHE_VOLUME}:/nix",
            "-v",
            f"{SCRIPT_DIR / 'agent-image'}:/build",
            NIX_IMAGE,
            "sh",
            "-c",
            "cd /build && nix flake update --extra-experimental-features 'nix-command flakes'",
        ],
        check=True,
    )
    print(f"{_sty('1;32', '✓')} flake.lock updated.")
    r = subprocess.run(
        ["git", "-C", str(SCRIPT_DIR), "diff", "--quiet", "HEAD", "--", "agent-image/flake.lock"],
        check=False,
    )
    if r.returncode == 0:
        print(_sty("2", "  flake.lock unchanged — nothing to commit."))
        return
    subprocess.run(["git", "-C", str(SCRIPT_DIR), "add", "agent-image/flake.lock"], check=True)
    subprocess.run(
        ["git", "-C", str(SCRIPT_DIR), "commit", "-m", "Update flake.lock"],
        check=True,
    )
    print(f"{_sty('1;32', '✓')} Committed.")


def parse_args(argv: list[str]) -> tuple[str, list[str], dict[str, Any]]:
    overrides: dict[str, Any] = {}
    args = list(argv)
    i = 0
    while i < len(args) and args[i].startswith("--") and args[i] != "--":
        flag = args.pop(i)
        if flag == "--help":
            return "help", [], overrides
        if flag.startswith("--mount-mode="):
            overrides["mount_mode"] = flag.split("=", 1)[1]
        elif flag == "--mount-mode":
            if i < len(args):
                overrides["mount_mode"] = args.pop(i)
            else:
                die("--mount-mode requires a value")
        else:
            die(f"unknown option: {flag!r} (run `agent help`)")
    if not args:
        return "run", [], overrides
    if args[0] == "--":
        return "run", args[1:], overrides
    if args[0] in SUBCOMMANDS:
        rest = args[1:]
        if rest and rest[0] == "--":
            rest = rest[1:]
        return args[0], rest, overrides
    die(f"unknown subcommand: {args[0]!r} (run `agent help`)")


def main() -> None:
    cmd, extra, overrides = parse_args(sys.argv[1:])

    if cmd == "help":
        print(HELP_TEXT, end="")
        return

    if cmd == "setup":
        run_setup()
        return

    if not settings_path().exists():
        run_setup()
    settings = load_settings()
    if "mount_mode" in overrides:
        if overrides["mount_mode"] not in {"pwd", "repo_root"}:
            die(f"invalid --mount-mode {overrides['mount_mode']!r}: must be pwd or repo_root")
        settings["mount_mode"] = overrides["mount_mode"]
    engine = settings["container_engine"]

    # Image is UID-keyed because the agent user inside it is baked at build time.
    image = os.environ.get("AGENT_IMAGE", f"agent:u{os.getuid()}g{os.getgid()}")

    check_engine(engine)

    if cmd == "doctor":
        run_doctor(engine, image)
        return

    if cmd == "clean":
        run_clean(engine)
        return

    if cmd == "update":
        run_update(engine)
        return

    if cmd == "check":
        subprocess.run(
            [
                engine,
                "run",
                "--rm",
                "-v",
                f"{SCRIPT_DIR / 'agent-image'}:/build:ro,z",
                NIX_IMAGE,
                "nix",
                "flake",
                "check",
                "path:/build",
                "--impure",
                "--extra-experimental-features",
                "nix-command flakes",
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        return

    if cmd == "build":
        build(engine, image)
        return

    if not image_exists(engine, image):
        build(engine, image)

    cwd = Path.cwd().resolve()
    if settings["mount_mode"] == "repo_root":
        mount_root = resolve_repo_root(cwd, Path.home().resolve())
    else:
        mount_root = cwd

    uid, gid = os.getuid(), os.getgid()
    # /nix is not volume-mounted: the container uses the image's built-in
    # /nix layer directly, so no seed-copy is needed on first run per image.
    # Nix store writes during a session (e.g. `nix build`) don't persist
    # across `--rm` runs.
    # The home volume is still separate: Docker seeds it from image content
    # on first creation. Home on a named volume (not a bind mount) keeps all
    # of ~/.elan, ~/.cache, ~/.local etc on native container fs, avoiding
    # FUSE/VirtioFS open-file limits (~14K cap vs ~25K+ for Lean builds).
    home_volume = f"{HOME_VOLUME_PREFIX}u{uid}g{gid}"

    xdg_data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
    old_home = xdg_data / "agent-container" / "home"
    volume_missing = _run_quiet([engine, "volume", "inspect", home_volume]).returncode != 0
    if old_home.is_dir() and volume_missing:
        print(f"{_sty('1;34', '→')} Migrating old home directory into {home_volume}...")
        _run_quiet([engine, "volume", "create", home_volume])
        r = subprocess.run(
            [engine, "run", "--rm",
             "-v", f"{old_home}:/mnt/old-home:ro",
             "-v", f"{home_volume}:/home/agent",
             "--entrypoint", "sh",
             image, "-c", "cp -a /mnt/old-home/. /home/agent/"],
            capture_output=True, text=True, check=False,
        )
        if r.returncode != 0:
            warn(f"migration failed: {r.stderr.strip() or f'exit {r.returncode}'}")
        else:
            print(f"{_sty('1;32', '✓')} Migrated. Old directory preserved at {old_home}")

    mount_specs = [
        f"{mount_root}:{mount_root}",
        f"{home_volume}:/home/agent",
    ]
    if Path("/etc/localtime").is_file():
        mount_specs.append("/etc/localtime:/etc/localtime:ro")
    cred_cache = Path.home() / ".cache/git/credential"
    if cred_cache.is_dir():
        mount_specs.append(f"{cred_cache}:/home/agent/.cache/git/credential")
    allowlist_container = {host: container for host, container, _ in SHARED_HOST_PATHS_ALLOWLIST}
    for entry in settings["shared_host_paths"]:
        if isinstance(entry, dict):
            host_pattern = _shared_host_entry_host(entry)
            container_path = _shared_host_entry_container(entry)
            if host_pattern is None or container_path is None:
                continue
        elif isinstance(entry, str):
            host_pattern = entry
            container_path = allowlist_container.get(entry)
            if container_path is None:
                continue
        else:
            continue
        host_path = Path(host_pattern).expanduser()
        if not host_path.exists():
            continue
        mount_specs.append(f"{host_path}:{container_path}:ro")
    mount_flags = [arg for m in mount_specs for arg in ("-v", m)]
    env_flags = [arg for e in settings["env_vars"] for arg in ("-e", e)]

    base = [engine, "run", "--rm", "-it", "--init", "--user", f"{uid}:{gid}"]
    if engine == "podman":
        # Rootless podman: map host UID to itself inside the user namespace.
        # Docker has no equivalent — rootless docker already runs as the host
        # uid, and rootful docker maps `--user` directly without a userns, so
        # don't add `--userns=keep-id` for docker.
        base.append("--userns=keep-id")
    base += [
        "--memory-swap=-1",
        "--ulimit", "nofile=524288:524288",
        *mount_flags,
        *env_flags,
        "-w",
        str(cwd),
    ]

    # SSH agent forwarding — key never enters the container.
    # macOS + Docker Desktop: socket injected by Docker Desktop at a fixed path.
    # Linux: forward the host socket via bind-mount.
    if sys.platform == "darwin" and engine == "docker":
        base += ["-e", "SSH_AUTH_SOCK=/run/host-services/ssh-auth.sock"]
    elif sys.platform != "darwin":
        _ssh_sock = os.environ.get("SSH_AUTH_SOCK", "")
        if _ssh_sock and Path(_ssh_sock).is_socket():
            base += ["-v", f"{_ssh_sock}:{_ssh_sock}", "-e", f"SSH_AUTH_SOCK={_ssh_sock}"]

    if cmd == "shell":
        tail = ["--entrypoint", "bash", image, *extra]
    else:
        tail = [image, "claude", "--dangerously-skip-permissions", *extra]

    os.execvp(engine, [*base, *tail])


if __name__ == "__main__":
    main()
