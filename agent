#!/usr/bin/env bash
set -euo pipefail

instance="${AGENT_LIMA_INSTANCE:-agent-sandbox}"
disk=agent-sandbox-home
disk_size="${AGENT_LIMA_DISK_SIZE:-100GiB}"
agent_command="${AGENT_COMMAND:-claude}"
agent_args=()
agent_command_hint="${agent_command}"
if [[ -z ${AGENT_COMMAND+x} ]]; then
    agent_args=(--dangerously-skip-permissions)
    agent_command_hint+=" ${agent_args[*]}"
fi
script_path=${BASH_SOURCE[0]}
while [[ -L ${script_path} ]]; do
    script_dir=$(cd -P -- "$(dirname -- "${script_path}")" && pwd)
    script_path=$(readlink "${script_path}")
    [[ ${script_path} = /* ]] || script_path="${script_dir}/${script_path}"
done
script_dir=$(cd -P -- "$(dirname -- "${script_path}")" && pwd)

usage() {
    cat <<'EOF'
Usage: agent [COMMAND] [ARGS...]

Run a coding agent in the Lima VM.

Commands:
  agent init                  Create and start the Lima VM
  agent                       Launch the configured coding agent
  agent -- ARGS...            Forward arguments to the coding agent
  agent shell [--] COMMAND... Open a shell or run a command in the VM
  agent git                   Ensure an 'agent' remote into the VM and push
  agent update                Update system packages and user tools
  agent help                  Show this help

Other commands are passed through to limactl.

Environment:
  AGENT_COMMAND  Coding-agent executable (default: claude)
  AGENT_LIMA_INSTANCE  Lima instance name (default: agent-sandbox)
  AGENT_LIMA_DISK_SIZE  Persistent disk size used by init (default: 100GiB)
EOF
}

require_limactl() {
    if ! command -v limactl >/dev/null 2>&1; then
        echo "agent: limactl is required but was not found on PATH" >&2
        exit 127
    fi
}

require_instance() {
    local instances
    instances=$(limactl list --quiet 2>/dev/null)
    if grep -Fqx "${instance}" <<<"${instances}"; then
        return
    fi
    echo "agent: Lima instance '${instance}' does not exist" >&2
    echo "Run 'agent init' to create it." >&2
    echo "If the VM already exists under another name, set AGENT_LIMA_INSTANCE to that name." >&2
    exit 1
}

launch_agent() {
    exec limactl shell "${instance}" -- "${agent_command}" "${agent_args[@]}" "$@"
}

case "${1:-}" in
"")
    require_limactl
    require_instance
    launch_agent
    ;;
--)
    shift
    require_limactl
    require_instance
    launch_agent "$@"
    ;;
init)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent init" >&2
        exit 2
    fi
    require_limactl
    instances=$(limactl list --quiet 2>/dev/null)
    if grep -Fqx "${instance}" <<<"${instances}"; then
        limactl start --yes --progress "${instance}"
    else
        if ! limactl disk list --json 2>/dev/null | grep -Fq '"name":"'"${disk}"'"'; then
            limactl disk create "${disk}" --size "${disk_size}"
        fi
        limactl start --yes --progress --name="${instance}" "${script_dir}/lima.yaml"
    fi
    printf '\nTry one of these commands:\n'
    printf '  agent shell  # open a shell in the VM\n'
    printf '  agent        # launch %s\n' "${agent_command_hint}"
    ;;
shell)
    shift
    require_limactl
    require_instance
    exec limactl shell "${instance}" "$@"
    ;;
git)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent git" >&2
        exit 2
    fi
    require_limactl
    require_instance
    repo_root=$("${script_dir}/find-git-root") ||
        {
            echo "agent: not inside a git repository" >&2
            exit 1
        }
    slug=$(basename -- "${repo_root}")
    slug=${slug// /-}
    # shellcheck disable=SC2088 # tilde is expanded remotely by git-upload/receive-pack
    remote_path="~/src/${slug}"
    if ! git -C "${repo_root}" remote get-url agent >/dev/null 2>&1; then
        # A normal (non-bare) checkout, so the agent running inside the VM
        # has a working tree to edit. updateInstead makes a push also
        # update that working tree, refusing if it has uncommitted changes.
        limactl shell "${instance}" -- bash -c \
            "mkdir -p ~/src && git init ~/src/${slug} &&
             git -C ~/src/${slug} config receive.denyCurrentBranch updateInstead"
        git -C "${repo_root}" remote add agent \
            "ext::limactl shell ${instance} -- %S ${remote_path}"
    fi
    git -C "${repo_root}" config protocol.ext.allow always
    git -C "${repo_root}" fetch agent
    # fast-forward only: leaves the checked-out branch alone if it has
    # diverged from the VM's copy instead of merging or rebasing it.
    branch=$(git -C "${repo_root}" symbolic-ref --quiet --short HEAD || true)
    if [[ -n ${branch} ]] &&
        git -C "${repo_root}" rev-parse --verify --quiet \
            "refs/remotes/agent/${branch}" >/dev/null; then
        git -C "${repo_root}" merge --ff-only "agent/${branch}" ||
            echo "agent: '${branch}' diverged from agent/${branch}; not pulling" >&2
    fi
    # plain (non-force) push: refs that would not fast-forward are rejected
    # instead of overwritten, so branches with diverging history are skipped.
    git -C "${repo_root}" push agent --all
    git -C "${repo_root}" push agent --tags
    ;;
update)
    if [[ $# -ne 1 ]]; then
        echo "usage: agent update" >&2
        exit 2
    fi
    require_limactl
    require_instance
    lock_name=${instance//[^[:alnum:]._-]/_}
    lock_dir="${TMPDIR:-/tmp}/agent-update-${UID}-${lock_name}.lock"
    if ! mkdir "${lock_dir}" 2>/dev/null; then
        echo "agent: update already running for Lima instance '${instance}'" >&2
        exit 1
    fi
    trap 'rmdir "${lock_dir}"' EXIT
    limactl shell --start "${instance}" -- \
        sudo rm -f /var/lib/lima/package-provision-complete
    limactl shell "${instance}" -- sudo bash -s <"${script_dir}/install-system"
    limactl shell "${instance}" -- bash -s <"${script_dir}/install-tools"
    ;;
help | -h | --help)
    usage
    ;;
*)
    require_limactl
    exec limactl "$@"
    ;;
esac
