@dataclass(frozen=True)
class AgentLaunch:
    """Coding-agent launch metadata for an extra package. `executable` is the
    binary `agent` execs; `args` are the fixed launch flags (approvals policy)
    appended before any user-supplied `--` extras."""

    executable: str
    label: str
    args: tuple[str, ...] = ()
    description: str = ""


@dataclass(frozen=True)
class ExtraPackage:
    """A curated native tool installed into the shared home volume through its
    own upstream mechanism. Install/update/remove routines are fixed here — never
    taken from settings — so the trust boundary stays in version control.

    `owned_paths` are the *specific* files and directories under /home/agent that
    Agent's managed installation creates. Removal touches nothing else, so a
    user's own tools and state can never be collected."""

    id: str
    label: str
    description: str
    install: str
    update: str
    owned_paths: tuple[str, ...]
    executables: tuple[str, ...]
    uninstall: str = ""
    agent: AgentLaunch | None = None


# A bare dotted version, wherever it is embedded — in a release tag or in the
# noise a tool's `--version` prints around it. This is the POSIX-ERE twin of
# `_VERSION_RE` below, which asks the same question of `--version` output in
# Python; ERE has no `\d` or `\w`, so the two cannot be one constant.
_VERSION_ERE = "[0-9]+\\.[0-9]+[0-9A-Za-z.+-]*"

# Read a release version off a URL ending in a release tag. Tag conventions
# differ — `v0.13.1` for typst, `tectonic@0.17.0` for tectonic, and the release
# feed percent-encodes that `@` — so drop everything up to the last separator
# before taking the version. Reads the URL on stdin.
_TAG_URL_TO_VERSION = f'sed "s|.*/||; s|.*%40||; s|.*@||" | grep -oE "{_VERSION_ERE}" | head -1'
_EXTRAS_DIR = "$HOME/.local/share/agent-extras"


def _astral_install(tool: str) -> str:
    """The Astral installers append PATH lines to six shell rc files and drop an
    `env` script unless their install dir is already on PATH. It always is here,
    so they stay quiet — but the image owns PATH, so say so outright rather than
    depend on that coincidence surviving a change to HOME_BIN_DIRS."""
    return f"curl -LsSf https://astral.sh/{tool}/install.sh | INSTALLER_NO_MODIFY_PATH=1 sh"


def _resolve_latest_version(repo: str, tag_prefix: str = "") -> str:
    """Set `$latest` to the version of a project's newest release.

    Resolved through the redirect on /releases/latest rather than the API, which
    is capped at 60 unauthenticated requests per hour per IP — tectonic builds
    its download URL out of this value, so a rate-limit hit there would fail an
    install, not just a version check. The redirect also settles which release
    counts as current: it names the newest non-prerelease, where the release
    feed lists the `-rc` tags that typst and ollama never ship as downloads.

    `tag_prefix` is for monorepos that publish several crates under one tag
    namespace. Tectonic releases `tectonic_pdf_io@…` and friends alongside
    `tectonic@…`, so /releases/latest can name a crate rather than the program;
    when it does, fall back to the newest matching tag in the release feed. The
    feed alone would not do — one batch of crate releases is enough to push the
    program's own tag off the feed's first page."""
    resolve = f"latest=$(curl -fsSL -o /dev/null -w '%{{url_effective}}' https://github.com/{repo}/releases/latest)\n"
    if tag_prefix:
        resolve += (
            f'case "${{latest##*/}}" in {tag_prefix}@*|{tag_prefix}%40*) ;;\n'
            f"  *) latest=$(curl -fsSL https://github.com/{repo}/releases.atom"
            f' | grep -oE "releases/tag/{tag_prefix}(@|%40)[0-9A-Za-z.+_-]*" | head -1) ;;\n'
            "esac\n"
        )
    return resolve + f'latest=$(printf %s "$latest" | {_TAG_URL_TO_VERSION})\n'


def _skip_if_latest(exe: str, repo: str, tag_prefix: str = "") -> str:
    """Guard for installers that always download a whole release: leave early when
    the installed tool already reports the latest published version. Anything
    uncertain — no tool, no version resolved, an unparsable version — falls
    through and reinstalls, so the guard can only ever save work, never skip a
    real update. Leaves the resolved version in `$latest` for installers whose
    download URL needs it."""
    return (
        _resolve_latest_version(repo, tag_prefix) + f"if command -v {exe} >/dev/null 2>&1; then\n"
        f'  have=$({exe} --version 2>&1 | grep -oE "{_VERSION_ERE}" | head -1)\n'
        '  if [ -n "$latest" ] && [ -n "$have" ] && [ "$latest" = "$have" ]; then exit 0; fi\n'
        "fi\n"
    )


# The three tarball entries below install a prebuilt upstream release into an
# Agent-owned directory and expose one symlink on PATH. Everything they write
# lives under paths the registry entry declares, so removal is exact. None of
# these tools can update itself, so the whole release is re-downloaded on every
# update run — hence the version guard in front of each.

_TYPST_INSTALL = (
    _skip_if_latest("typst", "typst/typst") + "set -e\n"
    'mkdir -p "$HOME/.local/bin"\n'
    f'rm -rf "{_EXTRAS_DIR}/typst"\n'
    f'mkdir -p "{_EXTRAS_DIR}/typst"\n'
    'curl -fsSL "https://github.com/typst/typst/releases/latest/download/typst-$(uname -m)-unknown-linux-musl.tar.xz"'
    f' | tar -xJ -C "{_EXTRAS_DIR}/typst" --strip-components=1\n'
    f'ln -sfn "{_EXTRAS_DIR}/typst/typst" "$HOME/.local/bin/typst"\n'
)

_TECTONIC_INSTALL = (
    # Tectonic's asset names embed the version, so unlike the two entries around
    # it there is no /releases/latest/download/<name> shortcut: the URL is built
    # from the version the guard already resolved. The musl build is static and
    # is the only one published for both architectures. The tarball holds a
    # single `tectonic` binary, hence no --strip-components.
    _skip_if_latest("tectonic", "tectonic-typesetting/tectonic", tag_prefix="tectonic") + "set -e\n"
    '[ -n "$latest" ] || { echo "cannot resolve the latest Tectonic release" >&2; exit 1; }\n'
    'mkdir -p "$HOME/.local/bin"\n'
    f'rm -rf "{_EXTRAS_DIR}/tectonic"\n'
    f'mkdir -p "{_EXTRAS_DIR}/tectonic"\n'
    'curl -fsSL "https://github.com/tectonic-typesetting/tectonic/releases/download'
    '/tectonic@$latest/tectonic-$latest-$(uname -m)-unknown-linux-musl.tar.gz"'
    f' | tar -xz -C "{_EXTRAS_DIR}/tectonic"\n'
    f'ln -sfn "{_EXTRAS_DIR}/tectonic/tectonic" "$HOME/.local/bin/tectonic"\n'
)

_OLLAMA_INSTALL = (
    # Ollama's tarball is ~1.5 GB, so skipping a redundant download saves minutes.
    _skip_if_latest("ollama", "ollama/ollama") + "set -e\n"
    'mkdir -p "$HOME/.local/bin"\n'
    'case "$(uname -m)" in aarch64|arm64) arch=arm64 ;; *) arch=amd64 ;; esac\n'
    f'rm -rf "{_EXTRAS_DIR}/ollama"\n'
    f'mkdir -p "{_EXTRAS_DIR}/ollama"\n'
    'curl -fsSL "https://github.com/ollama/ollama/releases/latest/download/ollama-linux-$arch.tar.zst"'
    f' | tar --zstd -x -C "{_EXTRAS_DIR}/ollama"\n'
    f'ln -sfn "{_EXTRAS_DIR}/ollama/bin/ollama" "$HOME/.local/bin/ollama"\n'
)

# The curated registry. Order is significant and stable: reconciliation always
