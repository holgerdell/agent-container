def die(msg: str) -> NoReturn:
    label = _sty("1;31", "error", err=True)
    print(f"agent: {label}: {msg}", file=sys.stderr)
    raise SystemExit(1)


def warn(msg: str) -> None:
    label = _sty("1;33", "warning", err=True)
    print(f"agent: {label}: {msg}", file=sys.stderr)


def settings_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg) if xdg else Path.home() / ".config"
    return base / "agent-container" / "settings.json"


def _parse_shared_mounts(raw: Any, path: Path) -> list[SharedMount]:
    if not isinstance(raw, list):
        warn(f"shared_host_paths in {path} is not a list; ignoring")
        return []
    allowlist = _allowlist_containers()
    mounts: list[SharedMount] = []
    for entry in raw:
        if isinstance(entry, str):
            if entry in allowlist:
                mounts.append(SharedMount(entry, allowlist[entry], builtin=True))
                continue
            warn(
                f"dropping shared_host_paths entry {entry!r} from {path}: "
                f"unknown host with no container mapping; use {{host: ..., container: ...}} form for custom mounts"
            )
            continue
        if isinstance(entry, dict):
            host = entry.get("host")
            container = entry.get("container")
            if isinstance(host, str) and host and isinstance(container, str) and container:
                mounts.append(SharedMount(host, container, builtin=False))
                continue
        warn(f"ignoring malformed shared_host_paths entry {entry!r} in {path}")
    return mounts


def _parse_env_vars(raw: Any, path: Path) -> list[str]:
    if not isinstance(raw, list):
        warn(f"env_vars in {path} is not a list; ignoring")
        return []
    result: list[str] = []
    for entry in raw:
        if isinstance(entry, str) and entry:
            result.append(entry)
        else:
            warn(f"ignoring malformed env_vars entry {entry!r} in {path}")
    return result


def _parse_apt_packages(raw: Any, path: Path) -> list[str]:
    if raw is None:
        return default_apt_packages()
    if not isinstance(raw, list):
        warn(f"apt_packages in {path} is not a list; using the default selection")
        return default_apt_packages()
    return normalize_apt_packages(raw)


def _parse_extra_packages(raw: Any, path: Path) -> list[str]:
    if raw is None:
        return list(DEFAULT_EXTRA_PACKAGES)
    if not isinstance(raw, list):
        warn(f"extra_packages in {path} is not a list; using the default selection")
        return list(DEFAULT_EXTRA_PACKAGES)
    selected, unknown = normalize_extra_packages(raw)
    for name in unknown:
        warn(f"ignoring unknown extra package {name!r} in {path}")
    return selected


def load_settings() -> Settings:
    path = settings_path()
    try:
        raw = path.read_text()
    except FileNotFoundError:
        return Settings()
    try:
        loaded = json.loads(raw)
    except json.JSONDecodeError as e:
        die(f"malformed settings file {path}: {e}\nRun `agent setup` to recreate it.")
    if not isinstance(loaded, dict):
        die(f"malformed settings file {path}: expected JSON object\nRun `agent setup` to recreate it.")
    known = {"mount_mode", "shared_host_paths", "env_vars", "coding_agent", "apt_packages", "extra_packages"}
    for key in loaded:
        if key not in known:
            warn(f"ignoring unknown setting {key!r} in {path}")
    mount_mode = loaded.get("mount_mode", "repo_root")
    if mount_mode not in {"pwd", "repo_root"}:
        warn(f"unknown mount_mode {mount_mode!r} in {path}; using 'repo_root'")
        mount_mode = "repo_root"
    coding_agent = loaded.get("coding_agent", DEFAULT_AGENT_ID)
    if coding_agent not in {p.id for p in launchable_agents()}:
        warn(f"unknown coding_agent {coding_agent!r} in {path}; using {DEFAULT_AGENT_ID!r}")
        coding_agent = DEFAULT_AGENT_ID
    return Settings(
        mount_mode=mount_mode,
        coding_agent=coding_agent,
        apt_packages=_parse_apt_packages(loaded.get("apt_packages"), path),
        extra_packages=_parse_extra_packages(loaded.get("extra_packages"), path),
        shared_host_paths=_parse_shared_mounts(loaded.get("shared_host_paths", []), path),
        env_vars=_parse_env_vars(loaded.get("env_vars", []), path),
    )


def save_settings(settings: Settings) -> None:
    path = settings_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=".settings.", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(settings.to_json(), f, indent=2, sort_keys=True)
            f.write("\n")
        tmp.chmod(0o644)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def _launch_agent(agent_id: str) -> AgentLaunch:
    entry = extra_by_id(agent_id)
    if entry is not None and entry.agent is not None:
        return entry.agent
    # A stale settings file naming a removed agent: fall back to the default
    # rather than die, mirroring mount_mode's lenient handling.
    default = extra_by_id(DEFAULT_AGENT_ID)
    assert default is not None and default.agent is not None
    return default.agent


def _ask_questions(current: Settings) -> Settings | None:
    default_marker = _sty("34", "(default)")

    mount_choices: list[tuple[str, str, str]] = []
    for label, value in [
        ("repository root (walk up to .git)", "repo_root"),
        ("current directory only", "pwd"),
    ]:
        if value == "repo_root":
            label = f"{label} {default_marker}"
        if value == "pwd":
            description = (
                "Share only this directory from the host with the container.\n"
                "Keeps access narrow, but sibling packages stay outside the workspace."
            )
        else:
            description = (
                "Walk up to .git and share the whole repository root from the host.\n"
                "Best for multi-package work, but exposes more project files."
            )
        mount_choices.append((label, value, description))

    mount_mode = tui_select(
        "How should agent choose which workspace directory to mount?",
        mount_choices,
        initial=current.mount_mode,
        summary_message="Workspace mount",
    )
    if mount_mode is None:
        return None

    agent_choices: list[tuple[str, str, str]] = []
    for entry in launchable_agents():
        assert entry.agent is not None
        label = f"{entry.agent.label} {default_marker}" if entry.id == DEFAULT_AGENT_ID else entry.agent.label
        agent_choices.append((label, entry.id, entry.agent.description))
    coding_agent = tui_select(
        "Which coding agent should `agent` launch by default?",
        agent_choices,
        initial=current.coding_agent,
        summary_message="Default coding agent",
    )
    if coding_agent is None:
        return None

    group_choices: list[tuple[str, str, str]] = [
        (f"{g.label}  {dim(', '.join(g.packages))}", g.id, group_state(g, current.apt_packages)) for g in APT_GROUPS
    ]
    custom = custom_apt_packages(current.apt_packages)
    custom_note = f"\nCustom packages kept as-is: {', '.join(custom)}." if custom else ""
    group_states = tui_tristate(
        "Which Debian package groups should the image contain?",
        group_choices,
        summary_message="Debian package groups",
        details=(
            "Groups are installed with apt during `agent build`.\n"
            "[~] means settings select only part of a group; leave it alone to keep that.\n"
            "Edit apt_packages in settings.json for individual or custom package names." + custom_note
        ),
    )
    if group_states is None:
        return None
    apt_packages = apply_group_states(current.apt_packages, group_states)

    extra_choices: list[tuple[str, str, bool]] = [
        (f"{e.label}  {dim(e.description)}", e.id, e.id in current.extra_packages) for e in EXTRA_REGISTRY
    ]
    extra_packages = tui_checkbox(
        "Which native extra tools should be installed in your home volume?",
        extra_choices,
        summary_message="Native extra tools",
        details=(
            "These are installed with their own upstream installers into the\n"
            "persistent home volume shared by all your repositories, and are\n"
            "installed, updated, or removed by `agent update`."
        ),
    )
    if extra_packages is None:
        return None

    selected_builtin_hosts = {m.host for m in current.shared_host_paths if m.builtin}
    builtin_choices: list[tuple[str, SharedMount, bool]] = [
        (f"{host}  {desc}", SharedMount(host, container, builtin=True), host in selected_builtin_hosts)
        for host, container, desc in SHARED_HOST_PATHS_ALLOWLIST
        if Path(host).expanduser().exists() or host in selected_builtin_hosts
    ]
    custom_choices: list[tuple[str, SharedMount, bool]] = [
        (f"{m.host} -> {m.container}  custom read-only mount", m, True) for m in current.shared_host_paths if not m.builtin
    ]
    available = builtin_choices + custom_choices
    shared_host_paths: list[SharedMount] = []
    if available:
        shared = tui_checkbox(
            "Which extra host paths should be mounted read-only into the container?",
            available,
            summary_message="Read-only host mounts",
            details=(
                "These mounts add host files or directories at fixed paths inside the container.\n"
                "Useful for config and auth, but each mount exposes more host state.\n"
                "Add custom entries by editing settings.json and re-running `agent setup`."
            ),
        )
        if shared is None:
            return None
        shared_host_paths = shared

    return replace(
        current,
        mount_mode=mount_mode,
        coding_agent=coding_agent,
        apt_packages=apt_packages,
        extra_packages=extra_packages,
        shared_host_paths=shared_host_paths,
    )


def run_setup() -> None:
    _tty_required()
    path = settings_path()
    current = load_settings() if path.exists() else Settings()

    print(_sty("2", f"Setup writes to {path}"))
    print()

    try:
        updated = _ask_questions(current)
    except (KeyboardInterrupt, EOFError):
        sys.exit(1)
    if updated is None:
        sys.exit(1)
    save_settings(updated)

    print()
    print(f"{_sty('1;32', '✓')} Saved.")
    # Saving never builds or installs: configuration changes must not silently
    # start a slow networked build.
    apt_changed = normalize_apt_packages(current.apt_packages) != normalize_apt_packages(updated.apt_packages)
    extras_changed = sorted(current.extra_packages) != sorted(updated.extra_packages)
    if apt_changed:
        print(f"  {dim('Debian packages changed — run `agent build` to rebuild the image.')}")
    if extras_changed:
        print(f"  {dim('Extra tools changed — run `agent update` to apply them.')}")


# --- Docker helpers ----------------------------------------------------------

_DOCKER_INSTALL_HINT = "https://docs.docker.com/get-docker/"


def _run_quiet(cmd: list[str]) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(cmd, capture_output=True, check=False)


def _run_text(cmd: list[str], *, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, input=stdin, capture_output=True, text=True, check=False)


def check_engine(engine: str, *, quiet: bool = False) -> None:
    """`quiet` suppresses the progress pair: `agent doctor --json` needs stdout to
    stay clean JSON, and this runs before doctor's own as_json branch even exists."""
    if not shutil.which(engine):
        die(f"{engine} not in PATH\nInstall: {_DOCKER_INSTALL_HINT}")

    # Runs on every invocation and is usually instant, but `engine info` can take
    # several seconds if the daemon is still cold-starting — print before, not after.
    if not quiet:
        _progress(f"{_sty('1;34', '→')} Checking {engine}...")
    info = _run_quiet([engine, "info"])
    if info.returncode != 0:
        stderr = info.stderr.decode(errors="replace").strip()
        die(f"`{engine} info` failed:\n{stderr}")
    if not quiet:
        _progress(f"{_sty('1;32', '✓')} {engine} ready.")


def short_id(image_id: str) -> str:
    """Docker's short form of a full image id, as `docker images` prints it."""
    return image_id.removeprefix("sha256:")[:12]


def image_exists(engine: str, image: str) -> bool:
    return _run_quiet([engine, "image", "inspect", image]).returncode == 0


def _volume_exists(engine: str, volume: str) -> bool:
    return _run_quiet([engine, "volume", "inspect", volume]).returncode == 0


def _image_id(engine: str, image: str) -> str:
    return _run_text([engine, "image", "inspect", "--format", "{{.Id}}", image]).stdout.strip()


def image_apt_fingerprint(engine: str, image: str) -> str | None:
    """The APT-selection fingerprint baked into the image, or None when the image
    is absent or predates the label."""
    r = _run_text([engine, "image", "inspect", "--format", f'{{{{index .Config.Labels "{APT_FINGERPRINT_LABEL}"}}}}', image])
    if r.returncode != 0:
        return None
    value = r.stdout.strip()
    return value or None


def _docker_version(engine: str) -> str:
    return _run_text([engine, "version", "--format", "{{.Server.Version}}"]).stdout.strip() or "unknown"


def _list_run_containers(engine: str, *, prefix: str = RUN_CONTAINER_PREFIX, running_only: bool = False) -> list[str]:
    """Names of persistent agent containers. `prefix` defaults to the general
    `agent-run-` namespace, which spans every user visible on this Docker host."""
    cmd = [engine, "ps"] if running_only else [engine, "ps", "-a"]
    cmd += ["--filter", f"name={prefix}", "--format", "{{.Names}}"]
    r = _run_text(cmd)
    return [n.strip() for n in r.stdout.splitlines() if n.strip()]


def _images_in_use(engine: str) -> set[str]:
    """Short image ids referenced by any existing container (running or stopped)."""
    r = _run_text([engine, "ps", "-aq", "--no-trunc"])
    if r.returncode != 0 or not r.stdout.strip():
        return set()
    container_ids = [c.strip() for c in r.stdout.splitlines() if c.strip()]
    ri = _run_text([engine, "inspect", "--format", "{{.Image}}", *container_ids])
    image_ids: set[str] = set()
    if ri.returncode == 0:
        for raw in ri.stdout.splitlines():
            raw = raw.strip()
            if raw:
                image_ids.add(short_id(raw))
    return image_ids


def _clean_step(label: str, cmd: list[str], *, missing_ok: bool = False) -> None:
    _progress(f"{_sty('1;34', '→')} {label}...")
    r = _run_quiet(cmd)
    stderr = r.stderr.decode(errors="replace").strip()
    if r.returncode == 0:
        print(f"{_sty('1;32', '✓')} {label}.")
        return
    if missing_ok:
        missing_markers = ("No such image", "No such object", "No such volume", "not found")
        if any(marker in stderr for marker in missing_markers):
            print(f"{_sty('2', '•')} {label}: already absent.")
            return
    warn(f"{label} failed: {stderr or f'exit {r.returncode}'}")


# --- Per-user build/update lock ----------------------------------------------


def _lock_path(username: str) -> Path:
    base = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "agent-container"
    base.mkdir(parents=True, exist_ok=True)
    return base / f"maintenance-{username}.lock"


@contextlib.contextmanager
def maintenance_lock(username: str) -> Iterator[None]:
    """Host-side exclusive lock shared by `agent build` and `agent update`. All
    repositories for a user share one mutable home volume and one extras-state
    file, so installers and state writes must never overlap. A concurrent
    invocation blocks here until the holder finishes."""
    path = _lock_path(username)
    with path.open("w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            _progress(f"{_sty('1;34', '→')} Another `agent build`/`agent update` is running; waiting...")
            fcntl.flock(f, fcntl.LOCK_EX)
        yield


# --- Image build -------------------------------------------------------------


def image_path_prefix() -> str:
    """The native-installer bin directories, as a PATH fragment."""
    return ":".join(f"{CONTAINER_HOME}/{d}" for d in HOME_BIN_DIRS)


def _login_profile_script() -> str:
    """A login shell runs /etc/profile, which rebuilds PATH from scratch and drops
    the image's `ENV PATH`. This snippet puts the native-installer directories
    back, so `bash -lc` sees exactly what a `docker exec` session sees."""
    dirs = " \\\n  ".join(f'"$HOME/{d}"' for d in HOME_BIN_DIRS)
    return (
        "# Generated by `agent build` from HOME_BIN_DIRS. Do not edit.\n"
        f"for d in \\\n  {dirs}; do\n"
        '  case ":$PATH:" in\n'
        '  *":$d:"*) ;;\n'
        '  *) PATH="$d:$PATH" ;;\n'
        "  esac\n"
        "done\n"
        "export PATH\n"
    )


def _write_build_context(context: Path, packages: list[str], fingerprint: str) -> None:
    """Assemble the temporary build context: the version-controlled Dockerfile
    and static root overlay, plus the generated package list, login-shell profile
    snippet, and image metadata."""
    shutil.copy2(IMAGE_DIR / "Dockerfile", context / "Dockerfile")
    shutil.copytree(IMAGE_DIR / "root", context / "root")
    profile_d = context / "root" / "etc" / "profile.d"
    profile_d.mkdir(parents=True, exist_ok=True)
    (profile_d / "agent.sh").write_text(_login_profile_script())
    (context / "apt-packages.txt").write_text("".join(f"{p}\n" for p in packages))
    (context / "image-metadata.json").write_text(
        json.dumps({"schema": 1, "apt_fingerprint": fingerprint, "apt_packages": packages}, indent=2) + "\n"
    )


def build_image(engine: str, image: str, settings: Settings, *, refresh: bool) -> None:
    """Build the image from the configured APT selection. Always `--pull`, so a
    republished base image invalidates the layers below it and the packages are
    reinstalled from the current Debian archive; otherwise cached layers are
    reused and an unchanged rebuild costs nothing. `refresh` adds `--no-cache`
    for an unconditional reinstall. Running containers are never touched: a
    stopped container whose fingerprint no longer matches is recreated lazily on
    its next launch."""
    packages = normalize_apt_packages(settings.apt_packages)
    if not packages:
        die("apt_packages is empty; run `agent setup` to choose at least one package group")
    fingerprint = apt_fingerprint(packages)
    uid, gid = os.getuid(), os.getgid()
    previous = short_id(_image_id(engine, image))

    print(f"{_sty('1;35', '⬢')} {bold('build → image')} {dim(f'({len(packages)} apt packages)')}")
    mode = "fresh pull, no cache" if refresh else "fresh pull, cached layers reused"
    _progress(f"  {_sty('1;34', '→')} Building {image} from {BASE_IMAGE}  {dim(f'({mode})')}")
    with tempfile.TemporaryDirectory(prefix="agent-build-") as tmp:
        context = Path(tmp)
        _write_build_context(context, packages, fingerprint)
        cmd = [
            engine,
            "build",
            "--pull",
            *(["--no-cache"] if refresh else []),
            "--tag",
            image,
            "--build-arg",
            f"AGENT_UID={uid}",
            "--build-arg",
            f"AGENT_GID={gid}",
            "--build-arg",
            f"AGENT_APT_FINGERPRINT={fingerprint}",
            "--build-arg",
            f"AGENT_PATH={image_path_prefix()}",
            str(context),
        ]
        rc = subprocess.run(cmd, check=False).returncode
    if rc != 0:
        die(f"image build failed (exit {rc})\nAPT is the authority on package names — check `apt_packages` in your settings.")
    print(f"  {_sty('1;32', '✓')} Image {image} ready  {dim(f'(apt {fingerprint})')}")

    # The old image is only removed once nothing references it, so a running
    # session on the superseded build stays valid.
    current = short_id(_image_id(engine, image))
    if previous and previous != current and previous not in _images_in_use(engine):
        _run_quiet([engine, "rmi", previous])


# --- Extra-package reconciliation: orchestration ------------------------------

# Every planned operation used to run in its own transient container: one to run
# the routine, one to probe its version, one to persist state. `build_reconcile_script`
# folds a whole run's operations into a single script so one container does the
# work, tagging each piece of output so `stream_reconcile_script` can report each
# operation as soon as its result is known — progress still prints live, as each
# operation finishes, even though it's all one container. Only the state read
# (needed to plan the operations) and the state write (needed after they're
# known) stay as separate container calls.
_OP_MARK = "@@AGENT-OP@@"
_VER_MARK = "@@AGENT-VER@@"


def build_reconcile_script(ops: list[ExtraOp], registry: tuple[ExtraPackage, ...] = EXTRA_REGISTRY) -> str:
    """One script covering every planned operation: a before-snapshot of every
    affected package's version taken together (one pass, like the old
    `version_probe_script`), then every operation's own install/update routine —
    almost entirely network calls — kicked off together in the background so
    they run concurrently instead of one download waiting on the last. `uv` is
    the one exception: `typos` and `mistral-vibe` shell out to it, so its
    operation is awaited on its own before anything else starts.

    Each operation still reports as a single tagged block (its result, captured
    output, and — on success — an after-snapshot of just that package), just
    like when it ran on its own; a `flock` around the print keeps two operations
    that finish at the same instant from interleaving mid-line. `set +e` so one
    operation's failure never stops the ones after it — exactly as when each ran
    in its own container."""
    before_entries = [e for op in ops if op.action != ACTION_REMOVE and (e := extra_by_id(op.package_id, registry)) and e.executables]
    lines = ["set +e", _version_snapshot_block(before_entries, "before"), "__lock=$(mktemp)", "__pids=()"]
    for op in ops:
        command = op_command(op, registry)
        entry = extra_by_id(op.package_id, registry)
        assert command is not None and entry is not None
        lines.append(f"# op: {op.package_id} {op.action}")
        after_block = _version_snapshot_block([entry], "after") if op.action != ACTION_REMOVE and entry.executables else ""
        job = (
            f"__out=$( {{\n{command}\n}} 2>&1 )\n"
            "__rc=$?\n"
            f'printf \'{_OP_MARK}\\t%s\\t%s\\t%s\\n\' "{op.package_id}" "{op.action}" "$__rc"\n'
            "printf '%s\\n' \"$__out\"\n"
        )
        if after_block:
            job += f'if [ "$__rc" -eq 0 ]; then\n{after_block}fi\n'
        lines.append(f'(\n__blk=$( {{\n{job}}} )\n{{ flock -x 9; printf \'%s\\n\' "$__blk"; }} 9>"$__lock"\n) &')
        lines.append('__pids+=("$!")')
        if op.package_id == "uv":
            lines.append('wait "${__pids[@]}"')
            lines.append("__pids=()")
    lines.append('wait "${__pids[@]}"')
    lines.append('rm -f "$__lock"')
    return "\n".join(lines) + "\n"


def _version_snapshot_block(entries: list[ExtraPackage], tag: str) -> str:
    """A version report for every one of `entries`, in a single pass, tagged
    `before` or `after` so `stream_reconcile_script` can tell the two apart. A
    tool that is missing or whose `--version` fails simply reports nothing."""
    specs = " ".join(f'"{e.id}:{e.executables[0]}"' for e in entries)
    if not specs:
        return ""
    return (
        f"for spec in {specs}; do\n"
        '  id="${spec%%:*}"; exe="${spec#*:}"; out=""\n'
        '  command -v "$exe" >/dev/null 2>&1 && out=$("$exe" --version 2>&1 | tr "\\n" " ")\n'
        f'  printf \'{_VER_MARK}\\t{tag}\\t%s\\t%s\\n\' "$id" "$out"\n'
        "done\n"
    )


OnOp = Callable[[str, str, int, str, dict[str, str], dict[str, str]], None]


def stream_reconcile_script(engine: str, image: str, volume: str, script: str, on_op: OnOp) -> tuple[int, str]:
    """Run the combined reconcile script, calling `on_op(package_id, action, rc,
    output, before, after)` as soon as each operation's result is known — the
    tagged lines `build_reconcile_script` emits arrive one operation at a time,
    so results are reported live instead of only after the whole container
    exits. `before`/`after` are the version-snapshot maps, filled in as their
    lines arrive (the before-snapshot always completes before the first
    operation runs). Returns (container exit status, full combined stdout) —
    the caller still needs these to notice operations that never reported at
    all (e.g. the container failed to start)."""
    uid, gid = os.getuid(), os.getgid()
    proc = subprocess.Popen(
        [
            engine,
            "run",
            "--rm",
            "--interactive",
            "--pull=never",
            "--user",
            f"{uid}:{gid}",
            "-v",
            f"{volume}:{CONTAINER_HOME}",
            "-e",
            f"HOME={CONTAINER_HOME}",
            image,
            "bash",
            "-lc",
            script,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None

    before: dict[str, str] = {}
    after: dict[str, str] = {}
    all_lines: list[str] = []
    pending: tuple[str, str, int] | None = None
    output_lines: list[str] = []

    def flush() -> None:
        nonlocal pending, output_lines
        if pending is not None:
            pkg, action, rc = pending
            on_op(pkg, action, rc, "\n".join(output_lines).strip(), before, after)
        pending = None
        output_lines = []

    for raw_line in proc.stdout:
        line = raw_line.rstrip("\n")
        all_lines.append(line)
        if line.startswith(_VER_MARK + "\t"):
            _, tag, pkg, raw = line.split("\t", 3)
            match = _VERSION_RE.search(raw)
            if match:
                (before if tag == "before" else after)[pkg] = match.group(0)
            if tag == "after":
                flush()
        elif line.startswith(_OP_MARK + "\t"):
            flush()
            _, pkg, action, rc = line.split("\t", 3)
            pending = (pkg, action, int(rc))
        elif pending is not None:
            output_lines.append(line)
    flush()
    proc.wait()
    return proc.returncode, "\n".join(all_lines)


def _updater_run(engine: str, image: str, volume: str, script: str, *, stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    """Run one command in a transient container as the normal Agent user, with
    the shared home volume mounted and normal network access. `bash -lc` so the
    command sees the same login-shell environment and PATH as a real session."""
    uid, gid = os.getuid(), os.getgid()
    return _run_text(
        [
            engine,
            "run",
            "--rm",
            "--interactive",
            "--pull=never",
            "--user",
            f"{uid}:{gid}",
            "-v",
            f"{volume}:{CONTAINER_HOME}",
            "-e",
            f"HOME={CONTAINER_HOME}",
            image,
            "bash",
            "-lc",
            script,
        ],
        stdin=stdin or "",
    )


def read_extras_state(engine: str, image: str, volume: str) -> dict[str, dict[str, Any]]:
    r = _updater_run(engine, image, volume, f'cat "{EXTRAS_STATE_PATH}" 2>/dev/null || true')
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    try:
        return parse_extras_state(json.loads(r.stdout))
    except json.JSONDecodeError:
        warn("managed-extras state file is unreadable; treating it as empty and leaving installed tools alone")
        return {}


def probe_extra_versions(engine: str, image: str, volume: str, ids: list[str]) -> dict[str, str]:
    """Ask the installed tools themselves what version they are. Purely
    informational: a probe that fails reports nothing rather than failing the
    command it decorates."""
    if not ids:
        return {}
    r = _updater_run(engine, image, volume, version_probe_script(ids))
    return parse_version_report(r.stdout)


def write_extras_state(engine: str, image: str, volume: str, state: dict[str, dict[str, Any]]) -> bool:
    """Persist the managed-extras map atomically inside the shared home volume.
    Returns whether the write succeeded: an unrecorded success would silently
    diverge from reality, so the caller counts a failure here like any other."""
    script = (
        f'set -e\nmkdir -p "$(dirname {EXTRAS_STATE_PATH})"\n'
        f'cat > "{EXTRAS_STATE_PATH}.tmp"\nmv "{EXTRAS_STATE_PATH}.tmp" "{EXTRAS_STATE_PATH}"\n'
    )
    r = _updater_run(engine, image, volume, script, stdin=extras_state_json(state))
    if r.returncode != 0:
        warn(f"could not record managed-extras state: {r.stderr.strip() or f'exit {r.returncode}'}")
        return False
    return True


_RESULT_STYLE = {
    RESULT_INSTALLED: green,
    RESULT_UPDATED: green,
    RESULT_REMOVED: cyan,
    RESULT_SKIPPED: dim,
    RESULT_FAILED: red,
    RESULT_UNCHANGED: dim,
}


def op_outcome(op: ExtraOp, ok: bool, before: dict[str, str], after: dict[str, str]) -> tuple[str, str]:
    """The reported (result, version note) for one finished operation. An update
    that did not move the version reads as "up to date" rather than "updated",
    since the two are indistinguishable to the user otherwise."""
    if not ok:
        return RESULT_FAILED, ""
    old, new = before.get(op.package_id, ""), after.get(op.package_id, "")
    result = _ACTION_RESULT[op.action]
    if op.action == ACTION_REMOVE or not new:
        return result, ""
    if old and old != new:
        return result, f"{old} → {new}"
    if op.action == ACTION_UPDATE and old == new:
        return RESULT_UNCHANGED, new
    return result, new


def outcome_headline(result: str, note: str) -> str:
    """The same outcome as one phrase, for the line the operation was announced
    on — so a long update reads as a sentence rather than as a summary lookup."""
    if not note:
        return result
    if result == RESULT_UNCHANGED:
        return f"{note} is already the newest version"
    return f"{result} {note}"


def reconcile_extras(engine: str, image: str, settings: Settings) -> int:
    """Converge the shared home volume on the selected extra packages. Every
    package is attempted even if an earlier one failed, so one upstream outage
    cannot block unrelated tools. Returns the number of failed operations."""
    username = current_username()
    volume = home_volume(username)
    selected, unknown = normalize_extra_packages(settings.extra_packages)
    for name in unknown:
        warn(f"unknown extra package {name!r} in settings; ignoring")

    state = read_extras_state(engine, image, volume)
    ops, stale = plan_reconciliation(selected, list(state))

    print(f"{_sty('1;35', '⬢')} {bold('extras → shared home volume')} {dim(f'({volume})')}")

    # Packages the state claims but the registry no longer defines: their owned
    # paths are unknown, so nothing is executed for them — they are reported as
    # skipped rather than silently dropped.
    for name in stale:
        warn(f"managed-extras state names unknown package {name!r}; leaving its files alone")
        print(f"  {_sty('1;34', '→')} {name}... {dim(RESULT_SKIPPED)}")

    if not ops and not stale:
        print(f"  {dim('Nothing to do.')}")
        return 0

    # Every operation runs in one shared container instead of one each, but
    # still reports as it goes — see `build_reconcile_script` and
    # `stream_reconcile_script`.
    failures = 0
    reported: set[str] = set()

    def on_op(pkg: str, action: str, rc: int, output: str, before: dict[str, str], after: dict[str, str]) -> None:
        nonlocal failures, state
        op = ExtraOp(pkg, action)
        entry = extra_by_id(pkg)
        assert entry is not None
        ok = rc == 0
        result, note = op_outcome(op, ok, before, after)
        print(f"  {_sty('1;34', '→')} {action} {entry.label}... " + _RESULT_STYLE[result](outcome_headline(result, note)), flush=True)
        if not ok:
            failures += 1
            warn(f"{action} of {pkg} failed (exit {rc})" + (f":\n{output}" if output else ""))
        state = apply_op_result(state, op, ok)
        reported.add(pkg)

    returncode, stdout = stream_reconcile_script(engine, image, volume, build_reconcile_script(ops), on_op)

    # An operation whose result never arrived (the container itself failed to
    # run the script at all) is not silently dropped — it's counted and
    # recorded exactly like any other failure.
    for op in ops:
        if op.package_id in reported:
            continue
        entry = extra_by_id(op.package_id)
        assert entry is not None
        failures += 1
        print(f"  {_sty('1;34', '→')} {op.action} {entry.label}... " + _RESULT_STYLE[RESULT_FAILED](RESULT_FAILED), flush=True)
        warn(f"{op.action} of {op.package_id} failed (exit {returncode})" + (f":\n{stdout}" if stdout else ""))
        state = apply_op_result(state, op, False)

    if not write_extras_state(engine, image, volume, state):
        failures += 1

    return failures


def maintain(engine: str, image: str, settings: Settings, *, always_build: bool, refresh: bool = False) -> int:
    """The shared build-then-reconcile phase, under the per-user lock. `agent
    build` always rebuilds; `agent update` builds only when no image exists yet,
    so first-time setup has a single useful command. `refresh` is the explicit
    `agent build --refresh` request and defaults off for every path that only
    builds incidentally. Returns the failure count."""
    with maintenance_lock(current_username()):
        if always_build or not image_exists(engine, image):
            build_image(engine, image, settings, refresh=refresh)
        return reconcile_extras(engine, image, settings)


def run_maintenance(engine: str, image: str, settings: Settings, *, always_build: bool, refresh: bool) -> None:
    """`agent build` / `agent update` proper: a failed package operation makes the
    whole command exit nonzero, so automation and scripts can see it."""
    failures = maintain(engine, image, settings, always_build=always_build, refresh=refresh)
    if failures:
        die(f"{failures} extra package operation(s) failed; rerun `agent update` to retry")


